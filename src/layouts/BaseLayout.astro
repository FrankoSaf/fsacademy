---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import '../styles/variables.css';
import '../styles/global.css';

import globals from '../../content/globals.json';
import ui from '../../content/ui.json';

const g = globals as Record<string, unknown>;
const googleAdsId = (g.googleAdsId as string) || '';
const googleAdsConversionId = (g.googleAdsConversionId as string) || '';
const conversionValue = (g.conversionValue as string) || '';
const conversionSendTo = googleAdsId && googleAdsConversionId ? `AW-${googleAdsId}/${googleAdsConversionId}` : '';
import landing from '../../content/landing.json';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonicalUrl, ogImage, noindex = false } = Astro.props;

// Use deploy URL only for netlify.app (preview/test) so canonical matches – avoids SEO warnings when testing
const deployUrl = typeof process !== 'undefined' ? (process.env.URL || process.env.DEPLOY_PRIME_URL) : null;
const site = (deployUrl && deployUrl.includes('netlify.app')) ? deployUrl : (Astro.site?.href || 'https://finesoundacademy.com');
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site).href;
const metaDescription = description ?? (globals as { defaultMetaDescription?: string }).defaultMetaDescription ?? 'Musikschule in Düsseldorf und Neuss: Professioneller Unterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug. Kostenlose Probestunde.';
const image = ogImage ?? (globals as { ogImage?: string }).ogImage ?? '';
const ogImageAlt = (globals as { ogImageAlt?: string }).ogImageAlt ?? 'Fine Sound Academy – Musikschule Düsseldorf & Neuss';
const twitterHandle = (globals as { twitterHandle?: string }).twitterHandle ?? '';
const imageUrl = image ? (image.startsWith('http') ? image : new URL(image, site).href) : null;
const imageMimeType = imageUrl && (imageUrl.toLowerCase().includes('.png') || imageUrl.toLowerCase().includes('noBgColor')) ? 'image/png' : 'image/jpeg';
const logoUrl = (landing as any)?.footer?.logo?.image ? ((landing as any).footer.logo.image.startsWith('http') ? (landing as any).footer.logo.image : new URL((landing as any).footer.logo.image, site).href) : imageUrl;

const ldOrganization = {
  '@context': 'https://schema.org',
  '@type': 'MusicSchool',
  '@id': `${site}#organization`,
  name: 'Fine Sound Academy',
  description: metaDescription,
  url: site,
  ...(imageUrl && { image: imageUrl }),
  ...(logoUrl && { logo: logoUrl }),
  telephone: '+49 176 77154511',
  email: 'info@finesoundacademy.com',
  sameAs: (landing as any).navigation?.socialMedia?.map((s: any) => s.url) ?? [],
  priceRange: '€€',
  areaServed: [
    { '@type': 'City', name: 'Düsseldorf' },
    { '@type': 'City', name: 'Neuss' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Musikunterricht',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Klavierunterricht' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gitarrenunterricht' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Gesangsunterricht' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Bassunterricht' } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Schlagzeugunterricht' } },
    ],
  },
  location: [
    {
      '@type': 'MusicSchool',
      name: 'Fine Sound Academy Düsseldorf',
      url: `${site}/duesseldorf`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Kaiserstr. 28',
        addressLocality: 'Düsseldorf',
        postalCode: '40479',
        addressCountry: 'DE',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 51.23387, longitude: 6.77908 },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '10:00', closes: '20:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '12:00' },
      ],
    },
    {
      '@type': 'MusicSchool',
      name: 'Fine Sound Academy Neuss',
      url: `${site}/neuss`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Neumarkt 18',
        addressLocality: 'Neuss',
        postalCode: '41460',
        addressCountry: 'DE',
      },
      geo: { '@type': 'GeoCoordinates', latitude: 51.1985, longitude: 6.6929 },
      openingHoursSpecification: [
        { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '10:00', closes: '20:00' },
        { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '12:00' },
      ],
    },
  ],
};

const ldWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Fine Sound Academy',
  url: site,
};

const ldWebPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: metaDescription,
  url: canonical,
  isPartOf: { '@id': `${site}#website` },
};

const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbs = (ui as { breadcrumbs?: Record<string, string> }).breadcrumbs ?? {};
const breadcrumbNames: Record<string, string> = {
  about: breadcrumbs.about ?? 'Über uns',
  preise: breadcrumbs.preise ?? 'Preise',
  kontakt: breadcrumbs.kontakt ?? 'Kontakt',
  unterricht: breadcrumbs.unterricht ?? 'Unterricht',
  duesseldorf: breadcrumbs.duesseldorf ?? 'Düsseldorf',
  neuss: breadcrumbs.neuss ?? 'Neuss',
  datenschutz: breadcrumbs.datenschutz ?? 'Datenschutz',
  impressum: breadcrumbs.impressum ?? 'Impressum',
  danke: breadcrumbs.danke ?? 'Vielen Dank',
  klavier: breadcrumbs.klavier ?? 'Klavier',
  gitarre: breadcrumbs.gitarre ?? 'Gitarre',
  bass: breadcrumbs.bass ?? 'Bass',
  gesang: breadcrumbs.gesang ?? 'Gesang',
  schlagzeug: breadcrumbs.schlagzeug ?? 'Schlagzeug',
};
const ldBreadcrumb = pathSegments.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: breadcrumbs.startseite ?? 'Startseite', item: site },
    ...pathSegments.map((seg, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: breadcrumbNames[seg] ?? seg.charAt(0).toUpperCase() + seg.slice(1),
      item: new URL(pathSegments.slice(0, i + 1).join('/') + '/', site).href,
    })),
  ],
} : null;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}

    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Fine Sound Academy" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content={imageMimeType} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />

    <script type="application/ld+json" set:html={JSON.stringify(ldOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldWebPage)} />
    {ldBreadcrumb && <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />}

    {/* Google Consent Mode v2 + gtag – loads only when conversion tracking is configured */}
    {conversionSendTo && (
      <>
        <script is:inline define:vars={{ conversionSendTo, conversionValue }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('consent', 'default', {
            'analytics_storage': 'denied',
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'wait_for_update': 500,
          });
          gtag('js', new Date());
          window.__FSA_GOOGLE_ADS_CONVERSION__ = conversionSendTo;
          window.__FSA_CONVERSION_VALUE__ = conversionValue ? parseFloat(conversionValue) : undefined;
        </script>
        <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=AW-${googleAdsId}`} async></script>
        <script is:inline define:vars={{ googleAdsId, conversionSendTo }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          gtag('config', 'AW-' + googleAdsId, { 'send_page_view': true });
        </script>
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{(ui as { skipLink?: string }).skipLink ?? 'Zum Inhalt springen'}</a>
    <header>
      <Nav />
    </header>
    <main id="main-content" class="content">
      <div class="page-width">
        <slot />
      </div>
    </main>
    <Footer />
    <StickyCtaBar />
    <WhatsAppButton />
    <CookieBanner />
    <script is:inline>
      (function() {
        if (window.location.hash.indexOf('invite_token') !== -1
            || window.location.hash.indexOf('confirmation_token') !== -1
            || window.location.hash.indexOf('recovery_token') !== -1) {
          var s = document.createElement('script');
          s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
          s.onload = function() {
            if (window.netlifyIdentity) {
              window.netlifyIdentity.on('init', function(user) {
                if (!user) {
                  window.netlifyIdentity.on('login', function() {
                    document.location.href = '/admin/';
                  });
                }
              });
            }
          };
          document.head.appendChild(s);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 10000;
    padding: 12px 24px;
    background: var(--color-gold);
    color: var(--color-black);
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 4px 4px;
    transition: top 0.2s;
  }
  .skip-link:focus {
    top: 0;
  }
</style>

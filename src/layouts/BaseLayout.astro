---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import StickyCtaBar from '../components/StickyCtaBar.astro';
import '../styles/fonts.css';
import '../styles/variables.css';
import '../styles/global.css';

import globals from '../../content/globals.json';
import ui from '../../content/ui.json';
import landing from '../../content/landing.json';
import { getNetlifyImageUrl, getPreset, type ImagePreset } from '../lib/images';
import { CONTACT, LOCATIONS, schoolSchema, INSTRUMENTS } from '../lib/site';
// Imported so Vite emits them and hands back the fingerprinted URLs; these are
// the only two faces needed for first paint (body copy and every h1), so they
// start downloading alongside the HTML instead of waiting for the CSS parse.
import dmSans400 from '../assets/fonts/dm-sans-latin-400-normal.woff2?url';
import fraunces700 from '../assets/fonts/fraunces-latin-700-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  /**
   * Above-the-fold hero image to preload, so the LCP fetch starts with the HTML
   * instead of waiting for the external stylesheet and layout. Must be the same
   * src + preset the page passes to <ResponsiveImage>, or the browser will
   * download two different files.
   */
  preloadHero?: { src: string; preset?: ImagePreset };
}

const g = globals as Record<string, unknown>;
const googleAdsId = (g.googleAdsId as string) || '';
const googleAdsConversionId = (g.googleAdsConversionId as string) || '';
const conversionValue = (g.conversionValue as string) || '';
const conversionSendTo = googleAdsId && googleAdsConversionId ? `AW-${googleAdsId}/${googleAdsConversionId}` : '';

const { title, description, canonicalUrl, ogImage, noindex = false, preloadHero } = Astro.props;

/*
 * Hero preload, mirroring what <ResponsiveImage> emits for the same preset.
 *
 * AVIF only, with an explicit `type`: browsers skip a preload whose type they
 * cannot decode, so non-AVIF clients simply fall through to the <picture> chain
 * rather than fetching a file twice. ResponsiveImage lists AVIF first, so this
 * is the candidate an AVIF-capable browser would have chosen anyway.
 */
const heroPreset = preloadHero ? getPreset(preloadHero.preset ?? 'hero') : null;
const heroPreload = preloadHero && heroPreset
  ? {
      srcset: heroPreset.dimensions
        .map((d) => {
          const url = getNetlifyImageUrl(preloadHero.src, {
            w: d.w,
            h: d.h,
            q: heroPreset.q ?? 80,
            fit: 'cover',
            position: heroPreset.position ?? 'center',
            fm: 'avif',
          });
          return `${url} ${d.w}w`;
        })
        .join(', '),
      sizes: heroPreset.sizes,
    }
  : null;

// Use the deploy URL only for Netlify preview domains so canonicals stay stable.
const deployUrl = typeof process !== 'undefined' ? (process.env.URL || process.env.DEPLOY_PRIME_URL) : null;
const site = deployUrl && deployUrl.includes('netlify.app')
  ? deployUrl
  : (Astro.site?.href || 'https://finesoundacademy.com');
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site).href;
const metaDescription = description
  ?? (globals as { defaultMetaDescription?: string }).defaultMetaDescription
  ?? 'Musikschule in Düsseldorf und Neuss: Professioneller Unterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug. Kostenlose Probestunde.';
const image = ogImage ?? (globals as { ogImage?: string }).ogImage ?? '';
const ogImageAlt = (globals as { ogImageAlt?: string }).ogImageAlt ?? 'Fine Sound Academy - Musikschule Düsseldorf & Neuss';
const twitterHandle = (globals as { twitterHandle?: string }).twitterHandle ?? '';

// og:image:width/height below are declared as 1200x630, so the image has to
// actually be that. Per-page overrides are arbitrary sources (CMS uploads,
// remote stock photos) at arbitrary sizes, so push everything through the
// image CDN at exactly 1200x630 rather than declaring dimensions that lie.
// Crawlers need an absolute URL, and they don't run JS, so this must resolve
// on the deployed origin.
const OG_W = 1200;
const OG_H = 630;
/** The one asset we ship at exactly OG_W x OG_H, so its size is known. */
const OG_CARD = '/brand/og-card.jpg';
const ogSource = image
  ? getNetlifyImageUrl(image, { w: OG_W, h: OG_H, q: 82, fit: 'cover', fm: 'jpeg' })
  : '';
const imageUrl = ogSource
  ? (ogSource.startsWith('http') ? ogSource : new URL(ogSource, site).href)
  : null;
/*
 * Only claim dimensions we can actually stand behind.
 *
 * getNetlifyImageUrl is a no-op outside a Netlify build, so a local or
 * third-party CI build emits the raw source URL - which for the per-instrument
 * overrides is a full-size remote stock photo, not 1200x630. Declaring the size
 * anyway is how the old markup ended up lying about a 3163x938 logo. Emit
 * width/height only when the URL really is the transformed one, or is the card
 * we generated at that exact size.
 */
const ogIsSized = Boolean(
  imageUrl && (ogSource.includes('/.netlify/images') || image === OG_CARD)
);
// Always JPEG now: `fm=jpeg` above flattens any transparency, which is what
// social cards want (a transparent PNG renders on an unpredictable ground).
const imageMimeType = 'image/jpeg';
const logoUrl = (landing as any)?.footer?.logo?.image
  ? ((landing as any).footer.logo.image.startsWith('http')
      ? (landing as any).footer.logo.image
      : new URL((landing as any).footer.logo.image, site).href)
  : imageUrl;

const googleAdsSrc = `https://www.googletagmanager.com/gtag/js?id=AW-${googleAdsId}`;
const consentBootstrapScript = [
  'window.dataLayer = window.dataLayer || [];',
  'function gtag(){ window.dataLayer.push(arguments); }',
  "gtag('consent', 'default', {",
  "  analytics_storage: 'denied',",
  "  ad_storage: 'denied',",
  "  ad_user_data: 'denied',",
  "  ad_personalization: 'denied',",
  '  wait_for_update: 500,',
  '});',
  "gtag('js', new Date());",
  `window.__FSA_GOOGLE_ADS_CONVERSION__ = ${JSON.stringify(conversionSendTo)};`,
  `window.__FSA_CONVERSION_VALUE__ = ${conversionValue ? `Number(${JSON.stringify(conversionValue)})` : 'undefined'};`,
].join('\n');
const consentConfigScript = [
  'window.dataLayer = window.dataLayer || [];',
  'function gtag(){ window.dataLayer.push(arguments); }',
  `gtag('config', 'AW-${googleAdsId}', { send_page_view: true });`,
].join('\n');
const identityWidgetScript = [
  '(function () {',
  "  if (window.location.hash.indexOf('invite_token') !== -1",
  "      || window.location.hash.indexOf('confirmation_token') !== -1",
  "      || window.location.hash.indexOf('recovery_token') !== -1) {",
  "    var script = document.createElement('script');",
  "    script.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';",
  '    script.onload = function () {',
  '      if (window.netlifyIdentity) {',
  "        window.netlifyIdentity.on('init', function (user) {",
  '          if (!user) {',
  "            window.netlifyIdentity.on('login', function () {",
  "              document.location.href = '/admin/';",
  '            });',
  '          }',
  '        });',
  '      }',
  '    };',
  '    document.head.appendChild(script);',
  '  }',
  '})();',
].join('\n');

// `site` always ends in a slash (Astro.site), so schema URLs below are built
// against it directly and inherit the site's `trailingSlash: 'always'` rule.
const siteBase = site.endsWith('/') ? site : `${site}/`;

const ldOrganization = {
  '@context': 'https://schema.org',
  '@type': 'School',
  '@id': `${siteBase}#organization`,
  name: CONTACT.name,
  description: metaDescription,
  url: siteBase,
  ...(imageUrl && { image: imageUrl }),
  ...(logoUrl && { logo: logoUrl }),
  telephone: CONTACT.phone,
  email: CONTACT.email,
  sameAs: (landing as any).navigation?.socialMedia?.map((s: any) => s.url) ?? [],
  areaServed: LOCATIONS.map((loc) => ({ '@type': 'City', name: loc.name })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Musikunterricht',
    itemListElement: INSTRUMENTS.map((inst) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: inst.lesson },
    })),
  },
  offers: {
    '@type': 'Offer',
    name: 'Monatliches Abo',
    description: 'Monatliches Abo für Musikunterricht.',
    url: `${siteBase}preise/`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      priceCurrency: 'EUR',
      billingDuration: 'P1M',
      unitText: 'MONTH',
    },
  },
  // Address, geo and hours from src/lib/site.ts, the same source the location
  // pages use, so the two can never disagree.
  location: LOCATIONS.map((loc) => schoolSchema(loc, siteBase)),
};

const ldWebSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  // ldWebPage.isPartOf points at this @id. Without it the reference dangled
  // and the WebPage node was orphaned from the graph.
  '@id': `${siteBase}#website`,
  name: CONTACT.name,
  url: siteBase,
  publisher: { '@id': `${siteBase}#organization` },
  inLanguage: 'de-DE',
};

const ldWebPage = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: metaDescription,
  url: canonical,
  isPartOf: { '@id': `${siteBase}#website` },
};

const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbs = (ui as { breadcrumbs?: Record<string, string> }).breadcrumbs ?? {};
const breadcrumbNames: Record<string, string> = {
  about: breadcrumbs.about ?? 'Über uns',
  preise: breadcrumbs.preise ?? 'Preise',
  kontakt: breadcrumbs.kontakt ?? 'Kontakt',
  unterricht: breadcrumbs.unterricht ?? 'Unterricht',
  duesseldorf: breadcrumbs.duesseldorf ?? 'Düsseldorf',
  neuss: breadcrumbs.neuss ?? 'Neuss',
  datenschutz: breadcrumbs.datenschutz ?? 'Datenschutz',
  impressum: breadcrumbs.impressum ?? 'Impressum',
  danke: breadcrumbs.danke ?? 'Vielen Dank',
  klavier: breadcrumbs.klavier ?? 'Klavier',
  gitarre: breadcrumbs.gitarre ?? 'Gitarre',
  bass: breadcrumbs.bass ?? 'Bass',
  gesang: breadcrumbs.gesang ?? 'Gesang',
  schlagzeug: breadcrumbs.schlagzeug ?? 'Schlagzeug',
};
const ldBreadcrumb = pathSegments.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: breadcrumbs.startseite ?? 'Startseite', item: site },
        ...pathSegments.map((seg, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: breadcrumbNames[seg] ?? seg.charAt(0).toUpperCase() + seg.slice(1),
          item: new URL(pathSegments.slice(0, i + 1).join('/') + '/', site).href,
        })),
      ],
    }
  : null;
---

<!doctype html>
<html lang="de" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
      </>
    )}

    <meta name="theme-color" content="#0a0a0a" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicon.ico" />

    <link rel="preload" href={dmSans400} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={fraunces700} as="font" type="font/woff2" crossorigin="anonymous" />

    {heroPreload && (
      <link
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroPreload.srcset}
        imagesizes={heroPreload.sizes}
        fetchpriority="high"
      />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Fine Sound Academy" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && <meta property="og:image:type" content={imageMimeType} />}
    {ogIsSized && <meta property="og:image:width" content={String(OG_W)} />}
    {ogIsSized && <meta property="og:image:height" content={String(OG_H)} />}
    {imageUrl && <meta property="og:image:alt" content={ogImageAlt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && <meta name="twitter:image:alt" content={ogImageAlt} />}
    {twitterHandle && <meta name="twitter:site" content={twitterHandle} />}

    <script type="application/ld+json" set:html={JSON.stringify(ldOrganization)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldWebSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldWebPage)} />
    {ldBreadcrumb && <script type="application/ld+json" set:html={JSON.stringify(ldBreadcrumb)} />}
    <slot name="head" />

    {conversionSendTo ? <script is:inline src={googleAdsSrc} async></script> : null}
    {conversionSendTo ? <script is:inline set:html={consentBootstrapScript}></script> : null}
    {conversionSendTo ? <script is:inline set:html={consentConfigScript}></script> : null}
  </head>
  <body>
    <a href="#main-content" class="skip-link">{(ui as { skipLink?: string }).skipLink ?? 'Zum Inhalt springen'}</a>
    <header>
      <Nav />
    </header>
    <main id="main-content" class="content">
      <div class="page-width">
        <slot />
      </div>
    </main>
    <Footer />
    <StickyCtaBar />
    <WhatsAppButton />
    <CookieBanner />
    <script is:inline set:html={identityWidgetScript}></script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 16px;
    z-index: 10000;
    padding: 12px 24px;
    background: var(--color-gold);
    color: var(--color-black);
    font-weight: 600;
    text-decoration: none;
    border-radius: 0 0 4px 4px;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 0;
  }
</style>

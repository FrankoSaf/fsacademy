---
import globalsRaw from '../../content/globals.json';

interface Notice {
  enabled?: boolean;
  label?: string;
  title?: string;
  text?: string;
  linkText?: string;
  linkUrl?: string;
}

const notice = (globalsRaw as { locationClosureNotice?: Notice }).locationClosureNotice;
const showNotice = notice?.enabled && (
  Astro.url.pathname === '/' || Astro.url.pathname.startsWith('/neuss/')
);
---

{showNotice && (
  <aside class="closure-notice" aria-labelledby="closure-notice-title">
    <div class="closure-notice-inner">
      <div class="closure-notice-copy">
        {notice.label && <p class="closure-notice-label">{notice.label}</p>}
        <p id="closure-notice-title" class="closure-notice-title">{notice.title}</p>
        <p class="closure-notice-text">{notice.text}</p>
      </div>
      {notice.linkText && notice.linkUrl && (
        <a class="closure-notice-link" href={notice.linkUrl}>{notice.linkText}<span aria-hidden="true"> →</span></a>
      )}
    </div>
  </aside>
)}

<style>
  .closure-notice {
    background: #f6ead7;
    border-bottom: var(--border-width-thin) solid var(--color-gold);
    color: var(--color-text-primary);
    padding: var(--space-lg);
  }

  .closure-notice-inner {
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xl);
  }

  .closure-notice-label {
    color: var(--color-gold-on-light);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-xs);
    text-transform: uppercase;
  }

  .closure-notice-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--space-xs);
  }

  .closure-notice-text {
    color: var(--color-text-secondary);
    max-width: 70ch;
  }

  .closure-notice-link {
    flex: 0 0 auto;
    color: var(--color-black);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 767px) {
    .closure-notice-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-md);
    }

    .closure-notice-title {
      font-size: var(--text-lg);
    }
  }
</style>

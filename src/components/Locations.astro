---
import contentRaw from '../../content/landing.json';

interface Location {
  name: string;
  image: string;
  buttonText: string;
  link: string;
}

interface LocationsContent {
  dusseldorf: Location;
  neuss: Location;
}

interface Content {
  locations: LocationsContent;
}

const content = contentRaw as Content;
---

<section class="locations" aria-label="Standorte">
  <div class="locations-grid">
    <article class="location-card">
      <picture>
        <source
          srcset={`${content.locations.dusseldorf.image}?w=800&q=80 800w, ${content.locations.dusseldorf.image}?w=1200&q=80 1200w`}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <img
          src={`${content.locations.dusseldorf.image}?w=800&q=80`}
          alt={`Musikschule ${content.locations.dusseldorf.name}`}
          class="location-image"
          loading="lazy"
          width="800"
          height="800"
        />
      </picture>
      <div class="location-overlay"></div>
      <div class="location-content">
        <h2>{content.locations.dusseldorf.name}</h2>
        <a href={content.locations.dusseldorf.link} class="location-button">
          {content.locations.dusseldorf.buttonText}
        </a>
      </div>
    </article>

    <article class="location-card">
      <picture>
        <source
          srcset={`${content.locations.neuss.image}?w=800&q=80 800w, ${content.locations.neuss.image}?w=1200&q=80 1200w`}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <img
          src={`${content.locations.neuss.image}?w=800&q=80`}
          alt={`Musikschule ${content.locations.neuss.name}`}
          class="location-image"
          loading="lazy"
          width="800"
          height="800"
        />
      </picture>
      <div class="location-overlay"></div>
      <div class="location-content">
        <h2>{content.locations.neuss.name}</h2>
        <a href={content.locations.neuss.link} class="location-button">
          {content.locations.neuss.buttonText}
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .locations {
    background: var(--color-bg-alt);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .location-card {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .location-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.6);
  }

  .location-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    z-index: 2;
    width: 100%;
    padding: var(--space-lg);
  }

  .location-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-2xl);
    font-weight: 600;
  }

  .location-button {
    display: inline-block;
    padding: var(--space-md) var(--space-2xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
  }

  .location-button:hover {
    background: transparent;
    color: var(--color-text-on-dark);
    border-color: var(--color-text-on-dark);
  }

  @media (max-width: 767px) {
    .locations-grid {
      grid-template-columns: 1fr;
    }

    .location-card {
      aspect-ratio: 4/3;
    }

    .location-content h2 {
      margin-bottom: var(--space-lg);
    }
  }
</style>

---
import ResponsiveImage from './ResponsiveImage.astro';
import { LOCATIONS } from '../lib/site';

const [duesseldorfData, neussData, landingData] = await Promise.all([
  import('../../content/duesseldorf.json'),
  import('../../content/neuss.json'),
  import('../../content/landing.json'),
]);

const locationsBlock = (landingData as { default?: { locationsBlock?: { heading?: string; intro?: string } } }).default?.locationsBlock;
const locationsHeading = locationsBlock?.heading ?? 'Unsere Standorte';
const locationsIntro = locationsBlock?.intro ?? 'Düsseldorf und Neuss — professioneller Musikunterricht an zwei Orten in der Region.';

interface LocationCard {
  image?: string;
  alt?: string;
  buttonText?: string;
}

interface LocationData {
  card?: LocationCard;
  hero?: { title: string };
}

const CONTENT_BY_SLUG: Record<string, { default: LocationData }> = {
  duesseldorf: duesseldorfData as { default: LocationData },
  neuss: neussData as { default: LocationData },
};

// Driven off LOCATIONS so adding a third location needs no change here, and so
// the links carry the trailing slash the site canonicalises to.
const locations = LOCATIONS.map((loc) => {
  const card = CONTENT_BY_SLUG[loc.slug]?.default.card ?? {};
  return {
    name: loc.name,
    image: card.image ?? '',
    alt: card.alt ?? `Musikschule ${loc.name}`,
    buttonText: card.buttonText ?? `Zur Schule ${loc.name}`,
    link: `/${loc.slug}/`,
  };
});
---

<section class="locations" aria-labelledby="locations-heading">
  <h2 id="locations-heading" class="locations-title">{locationsHeading}</h2>
  <p class="locations-intro">{locationsIntro}</p>
  <div class="locations-grid">
    {locations.map((location) => (
      <article class="location-card">
        <ResponsiveImage
          src={location.image}
          alt={location.alt}
          preset="location"
          class="location-image"
          loading="lazy"
        />
        <div class="location-overlay"></div>
        <div class="location-content">
          <p class="location-name">{location.name}</p>
          <a
            href={location.link}
            class="location-button"
            aria-label={`Zur Musikschule ${location.name}`}
          >
            {location.buttonText}
          </a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .locations {
    background: var(--color-bg-default);
    padding: var(--space-6xl) var(--space-lg);
  }

  .locations-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .locations-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto var(--space-4xl);
    line-height: 1.7;
    font-size: var(--text-base);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .location-card {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
  }

  .location-card picture {
    position: absolute;
    inset: 0;
  }

  .location-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.3) 60%);
  }

  .location-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .location-content .location-name {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    font-weight: 600;
    margin: 0 0 var(--space-md) 0;
  }

  .location-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-xs);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 48px;
    min-width: 160px;
    border-radius: var(--radius-sm);
  }

  .location-button:hover {
    background: transparent;
    color: var(--color-text-on-dark);
    border-color: var(--color-text-on-dark);
  }

  @media (max-width: 767px) {
    .locations {
      padding: var(--space-4xl) var(--space-md);
    }

    .locations-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .location-card {
      aspect-ratio: 3/2;
    }

    .location-content .location-name {
      font-size: var(--text-xl);
    }
  }
</style>

---
import contentRaw from '../../content/landing.json';

interface Location {
  name: string;
  image: string;
  buttonText: string;
  link: string;
}

interface LocationsContent {
  dusseldorf: Location;
  neuss: Location;
}

interface Content {
  locations: LocationsContent;
}

const content = contentRaw as Content;
---

<section class="locations" aria-labelledby="locations-heading">
  <h2 id="locations-heading" class="locations-title">Unsere Standorte</h2>
  <p class="locations-intro">Düsseldorf und Neuss — professioneller Musikunterricht an zwei Orten in der Region.</p>
  <div class="locations-grid">
    <article class="location-card">
      <picture>
        <source
          srcset={`${content.locations.dusseldorf.image}?w=800&q=80 800w, ${content.locations.dusseldorf.image}?w=1200&q=80 1200w`}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <img
          src={`${content.locations.dusseldorf.image}?w=800&q=80`}
          alt={`Musikschule ${content.locations.dusseldorf.name}`}
          class="location-image"
          loading="lazy"
          width="800"
          height="800"
        />
      </picture>
      <div class="location-overlay"></div>
      <div class="location-content">
        <h2>{content.locations.dusseldorf.name}</h2>
        <a href={content.locations.dusseldorf.link} class="location-button">
          {content.locations.dusseldorf.buttonText}
        </a>
      </div>
    </article>

    <article class="location-card">
      <picture>
        <source
          srcset={`${content.locations.neuss.image}?w=800&q=80 800w, ${content.locations.neuss.image}?w=1200&q=80 1200w`}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <img
          src={`${content.locations.neuss.image}?w=800&q=80`}
          alt={`Musikschule ${content.locations.neuss.name}`}
          class="location-image"
          loading="lazy"
          width="800"
          height="800"
        />
      </picture>
      <div class="location-overlay"></div>
      <div class="location-content">
        <h2>{content.locations.neuss.name}</h2>
        <a href={content.locations.neuss.link} class="location-button">
          {content.locations.neuss.buttonText}
        </a>
      </div>
    </article>
  </div>
</section>

<style>
  .locations {
    background: var(--color-bg-default);
    padding: var(--space-6xl) var(--space-lg);
  }

  .locations-title {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .locations-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 540px;
    margin: 0 auto var(--space-4xl);
    line-height: 1.7;
    font-size: var(--text-base);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-xl);
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .location-card {
    position: relative;
    aspect-ratio: 16/10;
    overflow: hidden;
    border-radius: 4px;
  }

  .location-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .location-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(10, 10, 10, 0.85) 0%, rgba(10, 10, 10, 0.3) 60%);
  }

  .location-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .location-content h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .location-button {
    display: inline-block;
    padding: var(--space-sm) var(--space-xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-xs);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .location-button:hover {
    background: transparent;
    color: var(--color-text-on-dark);
    border-color: var(--color-text-on-dark);
  }

  @media (max-width: 767px) {
    .locations {
      padding: var(--space-4xl) var(--space-md);
    }

    .locations-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .location-card {
      aspect-ratio: 3/2;
    }

    .location-content h2 {
      font-size: var(--text-xl);
    }
  }
</style>

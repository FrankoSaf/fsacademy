---
import contentRaw from '../../content/landing.json';

interface Content {
  homeIntro?: {
    heading?: string;
    paragraphs?: string[];
  };
}

const content = contentRaw as Content;
const intro = content.homeIntro ?? {
  heading: 'Fine Sound Academy – Deine Musikschule in Düsseldorf und Neuss',
  paragraphs: [
    'Die Fine Sound Academy ist deine Musikschule in Düsseldorf und Neuss. Wir bieten professionellen Unterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug – für Kinder, Jugendliche und Erwachsene. Ob du gerade erst anfängst oder deine Fähigkeiten vertiefen möchtest: Unsere erfahrenen Lehrkräfte begleiten dich auf deinem musikalischen Weg.',
    'Mit zwei Standorten bist du flexibel: Düsseldorf-Pempelfort (Kaiserstraße 28) und Neuss am Neumarkt 18. Beide Studios sind gut erreichbar und mit öffentlichen Verkehrsmitteln erreichbar. Individueller Einzel- oder Gruppenunterricht, flexible Terminplanung und eine kostenlose Probestunde – so lernst du uns und unser Konzept unverbindlich kennen.',
    'Über 500 Schüler vertrauen uns an beiden Standorten. Von Pop über Klassik bis Jazz und Rock: Wir finden den richtigen Einstieg für dich. Mit modernen Unterrichtsmethoden und einem freundlichen Team schaffen wir eine Umgebung, in der du dein musikalisches Potenzial entfalten kannst.'
  ]
};

const cards = [
  { title: 'Zwei Standorte', text: 'Düsseldorf & Neuss – flexibel und gut erreichbar.' },
  { title: 'Individuell', text: 'Einzel- oder Gruppenunterricht, für Anfänger und Fortgeschrittene.' },
  { title: 'Kostenlos testen', text: 'Unverbindliche Probestunde – wir lernen uns kennen.' },
];
---

<section class="home-intro" aria-labelledby="home-intro-heading">
  <div class="intro-container">
    <h2 id="home-intro-heading">{intro.heading}</h2>
    <p class="intro-lead">
      Professioneller Musikunterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug – in Düsseldorf und Neuss.
    </p>
    {intro.paragraphs && intro.paragraphs.length > 0 && (
      <div class="intro-paragraphs">
        {intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    )}
    <div class="intro-cards">
      {cards.map((card) => (
        <div class="intro-card">
          <p class="intro-card-title"><strong>{card.title}</strong></p>
          <p>{card.text}</p>
        </div>
      ))}
    </div>
    <p class="intro-cta">
      Buche jetzt deine <strong>kostenlose Probestunde</strong> und starte deine musikalische Reise mit der Fine Sound Academy.
    </p>
  </div>
</section>

<style>
  .home-intro {
    padding: var(--space-5xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .intro-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .home-intro h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-md);
    line-height: 1.3;
  }

  .intro-lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 65ch;
    margin-bottom: var(--space-lg);
  }

  .intro-paragraphs {
    max-width: 65ch;
    margin-bottom: var(--space-3xl);
  }

  .intro-paragraphs p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .intro-paragraphs p:last-child {
    margin-bottom: 0;
  }

  .intro-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .intro-card {
    padding: var(--space-xl);
    background: var(--color-bg-alt);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
    border-radius: var(--radius-md);
  }

  .intro-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .intro-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .intro-cta {
    font-size: var(--text-base);
    color: var(--color-text-primary);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .home-intro {
      padding: var(--space-4xl) var(--space-md);
    }

    .intro-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

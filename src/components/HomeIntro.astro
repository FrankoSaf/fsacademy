---
import contentRaw from '../../content/landing.json';

interface Content {
  homeIntro?: {
    heading?: string;
    lead?: string;
    paragraphs?: string[];
    cards?: Array<{ title?: string; text?: string }>;
    ctaText?: string;
  };
}

const content = contentRaw as Content;
const intro = content.homeIntro ?? {};
const heading = intro.heading ?? 'Fine Sound Academy – Deine Musikschule in Düsseldorf und Neuss';
const lead = intro.lead ?? 'Professioneller Musikunterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug – in Düsseldorf und Neuss.';
const paragraphs = intro.paragraphs ?? [
  'Die Fine Sound Academy ist deine Musikschule in Düsseldorf und Neuss. Wir unterrichten Klavier, Gitarre, Gesang, Bass und Schlagzeug – für Kinder, Jugendliche und Erwachsene. Egal ob Anfänger oder Fortgeschrittener: Unsere erfahrenen Lehrkräfte unterstützen dich dort, wo du stehst.',
  'Zwei Standorte: Düsseldorf-Pempelfort (Kaiserstraße 28) und Neuss am Neumarkt 18. Beide Studios sind gut mit öffentlichen Verkehrsmitteln erreichbar. Du entscheidest, ob Einzel- oder Gruppenunterricht – und Termine planen wir flexibel. Mit einer kostenlosen Probestunde lernst du uns unverbindlich kennen.',
  'Über 500 Schüler sind bereits dabei. Von Pop über Klassik bis Jazz und Rock – wir finden einen Einstieg, der zu dir passt. Moderner Unterricht, ein freundliches Team, eine entspannte Atmosphäre.'
];
const cards = intro.cards ?? [
  { title: 'Zwei Standorte', text: 'Düsseldorf und Neuss – beide gut mit ÖPNV erreichbar.' },
  { title: 'Individuell', text: 'Einzel- oder Gruppenunterricht, für Anfänger und Fortgeschrittene.' },
  { title: 'Kostenlos testen', text: 'Unverbindliche Probestunde zum Kennenlernen.' },
];
const ctaText = intro.ctaText ?? 'Buche jetzt deine kostenlose Probestunde und lerne uns und unser Konzept kennen.';
---

<section class="home-intro" aria-labelledby="home-intro-heading">
  <div class="intro-container">
    <h2 id="home-intro-heading">{heading}</h2>
    <p class="intro-lead" set:html={lead.replace(/Düsseldorf/g, '<a href="/duesseldorf">Düsseldorf</a>').replace(/Neuss/g, '<a href="/neuss">Neuss</a>')} />
    {paragraphs && paragraphs.length > 0 && (
      <div class="intro-paragraphs">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
    )}
    <div class="intro-cards">
      {cards.map((card) => (
        <div class="intro-card">
          <p class="intro-card-title"><strong>{card.title}</strong></p>
          <p>{card.text}</p>
        </div>
      ))}
    </div>
    <p class="intro-cta" set:html={ctaText.replace(/kostenlose Probestunde/gi, '<strong>kostenlose Probestunde</strong>')} />
  </div>
</section>

<style>
  .home-intro {
    padding: var(--space-5xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .intro-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .home-intro h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-md);
    line-height: 1.3;
  }

  .intro-lead {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 65ch;
    margin-bottom: var(--space-lg);
  }

  .intro-lead a {
    color: var(--color-gold-on-light);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .intro-lead a:hover {
    color: var(--color-gold);
  }

  .intro-paragraphs {
    max-width: 65ch;
    margin-bottom: var(--space-3xl);
  }

  .intro-paragraphs p {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-md);
  }

  .intro-paragraphs p:last-child {
    margin-bottom: 0;
  }

  .intro-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-lg);
    margin-bottom: var(--space-3xl);
  }

  .intro-card {
    padding: var(--space-xl);
    background: var(--color-bg-alt);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
    border-radius: var(--radius-md);
  }

  .intro-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .intro-card p {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .intro-cta {
    font-size: var(--text-base);
    color: var(--color-text-primary);
    line-height: 1.7;
    margin: 0;
  }

  @media (max-width: 768px) {
    .home-intro {
      padding: var(--space-4xl) var(--space-md);
    }

    .intro-cards {
      grid-template-columns: 1fr;
    }
  }
</style>

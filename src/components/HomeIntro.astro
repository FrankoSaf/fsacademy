---
import contentRaw from '../../content/landing.json';

interface Content {
  homeIntro?: {
    heading?: string;
    paragraphs?: string[];
  };
}

const content = contentRaw as Content;
const intro = content.homeIntro ?? {
  heading: 'Fine Sound Academy – Deine Musikschule in Düsseldorf und Neuss',
  paragraphs: [
    'Die Fine Sound Academy ist deine Musikschule in Düsseldorf und Neuss. Wir bieten professionellen Unterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug – für Kinder, Jugendliche und Erwachsene. Mit zwei Standorten in der Region bist du flexibel: Unser Studio in Düsseldorf-Pempelfort (Kaiserstraße 28) und unsere Schule am Neumarkt 18 in Neuss laden dich ein, dein Instrument zu entdecken oder deine musikalischen Fähigkeiten zu vertiefen.',
    'Bei der Fine Sound Academy steht der individuelle Fortschritt im Mittelpunkt. Ob Einzelunterricht oder Gruppenunterricht, ob Anfänger oder Fortgeschrittener – unsere erfahrenen Musiklehrer gestalten den Unterricht so, dass er zu deinen Zielen und deinem Tempo passt. Die kostenlose Probestunde gibt dir die Möglichkeit, uns unverbindlich kennenzulernen und zu spüren, ob die Chemie stimmt.',
    'Über 500 Schüler vertrauen bereits der Fine Sound Academy. Wir verbinden klassische Grundlagen mit modernen Stilen – von Pop über Rock bis hin zu Jazz und Klassik. Egal ob du Klavierspielen lernen, Gitarre entdecken oder deine Stimme trainieren möchtest: In Düsseldorf und Neuss findest du bei uns den richtigen Einstieg. Buche jetzt deine kostenlose Probestunde und starte deine musikalische Reise mit der Fine Sound Academy.'
  ]
};
---

<section class="home-intro" aria-labelledby="home-intro-heading">
  <div class="intro-container">
    <h2 id="home-intro-heading">{intro.heading}</h2>
    <div class="intro-content">
      {intro.paragraphs?.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .home-intro {
    padding: var(--space-5xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .intro-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .home-intro h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    color: var(--color-text-primary);
    font-weight: 600;
    margin-bottom: var(--space-xl);
    line-height: 1.3;
  }

  .intro-content {
    max-width: 70ch;
  }

  .intro-content p {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }

  .intro-content p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .home-intro {
      padding: var(--space-4xl) var(--space-md);
    }
  }
</style>

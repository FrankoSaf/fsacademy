---
import cookie from '../../content/cookie.json';
import globals from '../../content/globals.json';
import { href } from '../lib/links';

const c = cookie as {
  message?: string;
  learnMoreText?: string;
  learnMoreUrl?: string;
  acceptText?: string;
  declineText?: string;
  ariaLabel?: string;
};

/*
 * Only render the banner when there is actually something to consent to.
 *
 * BaseLayout loads gtag only when googleAdsId and googleAdsConversionId are
 * both set. With them empty - as they are now - no tracking script ever runs,
 * so a consent prompt asked permission for nothing while costing every visitor
 * an interstitial over the page. If Ads is switched on later, filling in
 * globals.json brings the banner back automatically.
 */
const g = globals as { googleAdsId?: string; googleAdsConversionId?: string };
const trackingEnabled = Boolean(g.googleAdsId && g.googleAdsConversionId);
const message = c.message ?? 'Wir verwenden Cookies, um Ihnen die bestmögliche Erfahrung auf unserer Website zu bieten. Durch die weitere Nutzung der Website stimmen Sie der Verwendung von Cookies zu.';
const learnMoreText = c.learnMoreText ?? 'Mehr erfahren';
const learnMoreUrl = c.learnMoreUrl ?? '/datenschutz';
const acceptText = c.acceptText ?? 'Akzeptieren';
const declineText = c.declineText ?? 'Ablehnen';
---

{trackingEnabled && (
<div
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-label={c.ariaLabel ?? 'Cookie-Hinweis'}
  hidden
>
  <div class="cookie-content">
    <p>
      {message}
      <a href={href(learnMoreUrl)}>{learnMoreText}</a>
    </p>
    <div class="cookie-buttons">
      <button id="cookie-accept" type="button" class="cookie-button accept">{acceptText}</button>
      <button id="cookie-decline" type="button" class="cookie-button decline">{declineText}</button>
    </div>
  </div>
</div>
)}

<style>
  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-bg-dark);
    border-top: var(--border-width-medium) solid var(--color-gold);
    padding: var(--space-lg);
    z-index: 9999;
    transform: translateY(100%);
    transition: transform var(--transition-base);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.3);
  }

  .cookie-banner.show {
    transform: translateY(0);
  }

  .cookie-content {
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2xl);
  }

  .cookie-content p {
    color: var(--color-text-on-dark);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  .cookie-content a {
    color: var(--color-gold);
    text-decoration: underline;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-sm);
    margin: 0 calc(-1 * var(--space-sm));
  }

  .cookie-content a:hover {
    color: var(--color-gold-light);
  }

  .cookie-buttons {
    display: flex;
    gap: var(--space-md);
    flex-shrink: 0;
  }

  .cookie-button {
    padding: var(--space-sm) var(--space-xl);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    min-height: 48px;
    cursor: pointer;
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    border-radius: var(--radius-sm);
  }

  .cookie-button.accept {
    background: var(--color-gold);
    color: var(--color-black);
  }

  .cookie-button.accept:hover {
    background: var(--color-gold-light);
  }

  .cookie-button.decline {
    background: transparent;
    color: var(--color-gold);
  }

  .cookie-button.decline:hover {
    background: var(--color-gold-alpha-10);
  }

  @media (max-width: 767px) {
    .cookie-content {
      flex-direction: column;
      text-align: center;
      gap: var(--space-lg);
    }

    .cookie-buttons {
      width: 100%;
      flex-direction: column;
    }

    .cookie-button {
      width: 100%;
    }
  }
</style>

<script>
  (function() {
    function initCookieBanner() {
  const COOKIE_NAME = 'cookie-consent';
  const COOKIE_EXPIRY_DAYS = 365;

  function getCookie(name: string): string | null {
    const value = `; ${document.cookie}`;
    const parts = value.split(`; ${name}=`);
    if (parts.length === 2) return parts.pop()?.split(';').shift() || null;
    return null;
  }

  function setCookie(name: string, value: string, days: number): void {
    const expires = new Date();
    expires.setTime(expires.getTime() + days * 24 * 60 * 60 * 1000);
    document.cookie = `${name}=${value};expires=${expires.toUTCString()};path=/`;
  }

  const banner = document.getElementById('cookie-banner');
  const acceptButton = document.getElementById('cookie-accept');
  const declineButton = document.getElementById('cookie-decline');
  if (!banner) return;

  /**
   * Publish the banner height so the floating CTA stack can sit above it
   * (see --cookie-banner-height in variables.css).
   */
  function setBannerOffset(px: number): void {
    document.documentElement.style.setProperty('--cookie-banner-height', `${px}px`);
  }

  function showBanner(): void {
    banner.hidden = false;
    // Two frames: one for `hidden` to drop, one so the transform transition
    // has a starting value to animate from.
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        banner.classList.add('show');
        setBannerOffset(banner.offsetHeight);
      });
    });
    // Deliberately NOT focusing a button here. Moving focus on load steals it
    // from the page before the visitor has done anything, and drops a keyboard
    // user into the banner instead of the content they came for. The banner is
    // the first thing in the tab order after the skip link, so it stays easy
    // to reach.
  }

  function hideBanner(): void {
    banner.classList.remove('show');
    setBannerOffset(0);
    const done = () => { banner.hidden = true; };
    banner.addEventListener('transitionend', done, { once: true });
    // Fallback in case the transition never fires (reduced motion collapses it).
    setTimeout(done, 400);
  }

  const consent = getCookie(COOKIE_NAME);
  if (!consent) {
    showBanner();
  }

  function updateConsent(granted: boolean) {
    if (typeof (window as any).gtag === 'function') {
      (window as any).gtag('consent', 'update', {
        analytics_storage: granted ? 'granted' : 'denied',
        ad_storage: granted ? 'granted' : 'denied',
        ad_user_data: granted ? 'granted' : 'denied',
        ad_personalization: granted ? 'granted' : 'denied',
      });
    }
  }

  acceptButton?.addEventListener('click', () => {
    setCookie(COOKIE_NAME, 'accepted', COOKIE_EXPIRY_DAYS);
    updateConsent(true);
    hideBanner();
  });

  declineButton?.addEventListener('click', () => {
    setCookie(COOKIE_NAME, 'declined', COOKIE_EXPIRY_DAYS);
    updateConsent(false);
    hideBanner();
  });

  // Escape dismisses the banner for this page view only - it must NOT write a
  // consent cookie. Previously it stored a 365-day "declined", so a visitor
  // pressing Escape to get a dialog out of the way silently opted out for a
  // year without knowing it. With no cookie set the banner returns on the next
  // page, so the actual choice stays with the two buttons.
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && banner.classList.contains('show')) {
      hideBanner();
    }
  });
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(initCookieBanner, { timeout: 2000 });
    } else {
      setTimeout(initCookieBanner, 1);
    }
  })();
</script>

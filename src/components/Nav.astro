---
import contentRaw from '../../content/landing.json';

// Type definitions
interface SocialMedia {
  name: string;
  url: string;
  icon: 'facebook' | 'instagram' | 'linkedin' | 'whatsapp' | 'tiktok';
}

interface NavLink {
  text: string;
  url: string;
}

interface Navigation {
  logo: {
    primaryImage: string;
    secondaryImage: string;
    alt: string;
    link: string;
  };
  socialMedia: SocialMedia[];
  links: NavLink[];
  cta: {
    text: string;
    url: string;
  };
}

interface Content {
  navigation: Navigation;
}

const content = contentRaw as Content;
const navLinks = content?.navigation?.links ?? [];
const linksBeforeLogo = navLinks.slice(0, 2);
const linksAfterLogo = navLinks.slice(2);

// Simple SVG icons
const socialIcons: Record<string, string> = {
  facebook:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>',
  instagram:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>',
  linkedin:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>',
  whatsapp:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>',
  tiktok:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>',
};
---

<nav id="mainNav" class="nav-dark" aria-label="Hauptnavigation">
  <div class="nav-container">
    <button class="mobile-toggle" aria-label="Menü öffnen" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-left desktop-only">
      <div class="nav-social">
        {
          content &&
            content.navigation.socialMedia.map((social) =>
              socialIcons[social.icon] ? (
                <a
                  href={social.url}
                  class="social-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={social.name}
                >
                  <Fragment set:html={socialIcons[social.icon]} />
                </a>
              ) : null
            )
        }
      </div>
    </div>

    <div class="nav-center desktop-only">
      <ul class="nav-links">
        {linksBeforeLogo.map((link) => (
          <li>
            <a href={link.url}>{link.text}</a>
          </li>
        ))}
      </ul>
      <a href={content.navigation.logo.link} class="nav-logo-link" aria-label={content.navigation.logo.alt}>
        <img
          src={content.navigation.logo.primaryImage}
          alt=""
          width="140"
          height="40"
          class="nav-logo primary-image"
          fetchpriority="high"
        />
        <img
          src={content.navigation.logo.secondaryImage}
          alt=""
          width="140"
          height="40"
          class="nav-logo secondary-image"
        />
      </a>
      <ul class="nav-links">
        {linksAfterLogo.map((link) => (
          <li>
            <a href={link.url}>{link.text}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-right desktop-only">
      <div class="nav-cta">
        <a href={content.navigation.cta.url}>{content.navigation.cta.text}</a>
      </div>
    </div>

    <a href={content.navigation.logo.link} class="nav-logo-link mobile-only" aria-label={content.navigation.logo.alt}>
      <img
        src={content.navigation.logo.primaryImage}
        alt=""
        width="120"
        height="34"
        class="nav-logo primary-image"
      />
      <img
        src={content.navigation.logo.secondaryImage}
        alt=""
        width="120"
        height="34"
        class="nav-logo secondary-image"
      />
    </a>

  </div>

  <div class="mobile-menu" id="mobile-menu" role="region" aria-label="Mobiles Menü">
    <ul class="mobile-nav-links">
      {
        content &&
          content.navigation.links.map((link) => (
            <li>
              <a href={link.url}>{link.text}</a>
            </li>
          ))
      }
    </ul>
    <div class="mobile-cta">
      <a href={content.navigation.cta.url}>{content.navigation.cta.text}</a>
    </div>
    <div class="mobile-social">
      {
        content &&
          content.navigation.socialMedia.map((social) =>
            socialIcons[social.icon] ? (
              <a
                href={social.url}
                class="social-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={social.name}
              >
                <Fragment set:html={socialIcons[social.icon]} />
              </a>
            ) : null
          )
      }
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    border-bottom: var(--border-width-thin) solid transparent;
    z-index: 1000;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  nav.nav-dark {
    background: var(--color-bg-dark);
    border-bottom-color: var(--color-gold-alpha-20);
  }

  nav.nav-dark .social-link,
  nav.nav-dark .nav-links a {
    color: var(--color-text-on-dark);
  }

  nav.nav-dark .nav-links a:hover {
    color: var(--color-gold);
  }

  nav.nav-scrolled {
    background: var(--color-bg-default);
    border-bottom-color: var(--color-gold-alpha-20);
  }

  nav.nav-scrolled .social-link,
  nav.nav-scrolled .nav-links a {
    color: var(--color-text-primary);
  }

  nav.nav-scrolled .nav-links a:hover {
    color: var(--color-gold-on-light);
  }

  nav.nav-dark .mobile-toggle span {
    background: var(--color-gold);
  }

  nav.nav-scrolled .mobile-toggle span {
    background: var(--color-text-primary);
  }

  .nav-container {
    max-width: var(--container-wide-max-width);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-left {
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    justify-self: center;
  }

  .nav-center .nav-links {
    margin: 0;
    padding: 0;
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-self: end;
  }

  .nav-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-logo-link .nav-logo {
    display: block;
    height: 2.25rem;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }

  .nav-logo-link .primary-image {
    display: block;
  }

  .nav-logo-link .secondary-image {
    display: none;
  }

  nav.nav-scrolled .nav-logo-link .primary-image {
    display: none;
  }

  nav.nav-scrolled .nav-logo-link .secondary-image {
    display: block;
  }

  .nav-social {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .social-link {
    transition: color var(--transition-base), opacity var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    min-width: 44px;
    min-height: 44px;
  }

  .social-link:hover {
    opacity: 1;
    color: var(--color-gold);
  }

  .nav-links {
    display: flex;
    gap: var(--space-xl);
    list-style: none;
    font-family: var(--font-sans);
  }

  .nav-links a {
    text-decoration: none;
    font-weight: 400;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    transition: all var(--transition-base);
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: var(--border-width-thin);
    background: var(--color-gold);
    transition: width var(--transition-base);
  }

  .nav-links a:hover {
    color: var(--color-gold);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .nav-cta a {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem var(--space-lg);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-xs);
    transition: all var(--transition-base);
    min-height: 44px;
  }

  .nav-cta a:hover {
    background: var(--color-gold-light);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    align-items: center;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    transition: background var(--transition-base);
  }

  .mobile-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }

  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .mobile-menu {
    display: none;
    background: var(--color-bg-default);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
    padding: var(--space-lg);
  }

  .mobile-menu.active {
    display: block;
  }

  .mobile-nav-links {
    list-style: none;
    margin-bottom: var(--space-lg);
  }

  .mobile-nav-links li {
    margin-bottom: var(--space-xs);
  }

  .mobile-nav-links a {
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 400;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-family: var(--font-sans);
    transition: color var(--transition-base);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .mobile-nav-links a:hover {
    color: var(--color-gold);
  }

  .mobile-cta a {
    display: block;
    text-align: center;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    min-height: 44px;
  }

  .mobile-social {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  /* Mobile menu always has light bg – icons must stay dark (nav-dark uses white) */
  nav .mobile-menu .mobile-social .social-link {
    color: var(--color-text-primary);
  }

  nav .mobile-menu .mobile-social .social-link:hover {
    color: var(--color-gold-on-light);
  }

  .mobile-only {
    display: none;
  }

  .desktop-only {
    display: flex;
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none;
    }

    .mobile-only {
      display: flex;
    }

    .nav-container {
      grid-template-columns: auto 1fr;
      gap: var(--space-sm);
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-logo-link.mobile-only {
      justify-self: center;
    }

    .nav-logo-link.mobile-only .nav-logo {
      height: 1.85rem;
      max-width: 120px;
    }

    .nav-logo-link.mobile-only .secondary-image {
      height: 1.85rem;
      max-width: 120px;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.mobile-toggle') as HTMLButtonElement | null;
  const mobileMenu = document.querySelector('.mobile-menu');

  function setMenuOpen(open: boolean) {
    if (!toggle || !mobileMenu) return;
    toggle.classList.toggle('active', open);
    mobileMenu.classList.toggle('active', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Menü schließen' : 'Menü öffnen');

    if (open) {
      const firstLink = mobileMenu.querySelector('a, button') as HTMLElement | null;
      firstLink?.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  document.addEventListener('keydown', (e) => {
    if (!toggle || !mobileMenu) return;
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';

    if (e.key === 'Escape' && isOpen) {
      setMenuOpen(false);
      toggle.focus();
      return;
    }

    if (e.key === 'Tab' && isOpen) {
      const focusable = [toggle, ...mobileMenu.querySelectorAll<HTMLElement>('a, button')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });

  const mobileLinks = document.querySelectorAll('.mobile-nav-links a, .mobile-cta a');
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  const nav = document.getElementById('mainNav');
  const scrollThreshold = 60;

  function updateNavScroll() {
    if (window.scrollY > scrollThreshold) {
      nav?.classList.add('nav-scrolled');
    } else {
      nav?.classList.remove('nav-scrolled');
    }
  }

  updateNavScroll();
  window.addEventListener('scroll', updateNavScroll, { passive: true });
</script>

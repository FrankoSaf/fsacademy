---
import contentRaw from '../../content/landing.json';
import uiRaw from '../../content/ui.json';
import { href, linkAttrs } from '../lib/links';
import { socialIcon } from '../lib/social-icons';

// Type definitions
interface SocialMedia {
  name: string;
  url: string;
  icon: 'facebook' | 'instagram' | 'linkedin' | 'whatsapp' | 'tiktok';
}

interface NavLink {
  text: string;
  url: string;
}

interface Navigation {
  logo: {
    primaryImage: string;
    secondaryImage: string;
    alt: string;
    link: string;
  };
  socialMedia: SocialMedia[];
  links: NavLink[];
  cta: {
    text: string;
    url: string;
  };
}

interface Content {
  navigation: Navigation;
}

const content = contentRaw as Content;
const ui = uiRaw as { menuOpen?: string; menuClose?: string; navAriaLabel?: string; mobileMenuAriaLabel?: string };
const navLinks = content?.navigation?.links ?? [];
const linksBeforeLogo = navLinks.slice(0, 2);
const linksAfterLogo = navLinks.slice(2);
const socials = (content?.navigation?.socialMedia ?? []).filter((s) => socialIcon(s.icon));
const logo = content.navigation.logo;
// Intrinsic ratio of the logo SVG is 3162.36 / 937.24 = 3.374, so these
// width/height pairs match what the CSS actually renders and reserve the right
// box up front instead of nudging the nav once the SVG lands.
const LOGO_DESKTOP = { w: 135, h: 40 };
const LOGO_MOBILE = { w: 111, h: 33 };
---

<nav id="mainNav" class="nav-dark" aria-label={ui.navAriaLabel ?? 'Hauptnavigation'}>
  <div class="nav-container">
    <button class="mobile-toggle" aria-label={ui.menuOpen ?? 'Menü öffnen'} aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="nav-left desktop-only">
      <div class="nav-social">
        {socials.map((social) => (
          <a href={social.url} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={social.name}>
            <Fragment set:html={socialIcon(social.icon)} />
          </a>
        ))}
      </div>
    </div>

    <div class="nav-center desktop-only">
      <ul class="nav-links">
        {linksBeforeLogo.map((link) => (
          <li>
            <a href={href(link.url)} {...linkAttrs(link.url)}>{link.text}</a>
          </li>
        ))}
      </ul>
      <a href={href(logo.link)} class="nav-logo-link" aria-label={logo.alt}>
        <img
          src={logo.primaryImage}
          alt={logo.alt}
          width={LOGO_DESKTOP.w}
          height={LOGO_DESKTOP.h}
          class="nav-logo primary-image"
          fetchpriority="high"
        />
        {/* Swapped in by .nav-scrolled: the light logo would be white-on-white
            once the nav background turns light. alt="" because the primary
            image above already names the brand. */}
        <img
          src={logo.secondaryImage}
          alt=""
          width={LOGO_DESKTOP.w}
          height={LOGO_DESKTOP.h}
          class="nav-logo secondary-image"
        />
      </a>
      <ul class="nav-links">
        {linksAfterLogo.map((link) => (
          <li>
            <a href={href(link.url)} {...linkAttrs(link.url)}>{link.text}</a>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-right desktop-only">
      <div class="nav-cta">
        <a href={href(content.navigation.cta.url)} {...linkAttrs(content.navigation.cta.url)}>{content.navigation.cta.text}</a>
      </div>
    </div>

    <a href={href(logo.link)} class="nav-logo-link mobile-only" aria-label={logo.alt}>
      <img
        src={logo.primaryImage}
        alt={logo.alt}
        width={LOGO_MOBILE.w}
        height={LOGO_MOBILE.h}
        class="nav-logo primary-image"
        fetchpriority="high"
      />
      <img
        src={logo.secondaryImage}
        alt=""
        width={LOGO_MOBILE.w}
        height={LOGO_MOBILE.h}
        class="nav-logo secondary-image"
      />
    </a>

  </div>

  <div class="mobile-menu" id="mobile-menu" role="region" aria-label={ui.mobileMenuAriaLabel ?? 'Mobiles Menü'}>
    <ul class="mobile-nav-links">
      {navLinks.map((link) => (
        <li>
          <a href={href(link.url)} {...linkAttrs(link.url)}>{link.text}</a>
        </li>
      ))}
    </ul>
    <div class="mobile-cta">
      <a href={href(content.navigation.cta.url)} {...linkAttrs(content.navigation.cta.url)}>{content.navigation.cta.text}</a>
    </div>
    <div class="mobile-social">
      {socials.map((social) => (
        <a href={social.url} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={social.name}>
          <Fragment set:html={socialIcon(social.icon)} />
        </a>
      ))}
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    border-bottom: var(--border-width-thin) solid transparent;
    z-index: 1000;
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  nav.nav-dark {
    background: var(--color-bg-dark);
    border-bottom-color: var(--color-gold-alpha-20);
  }

  nav.nav-dark .social-link,
  nav.nav-dark .nav-links a {
    color: var(--color-text-on-dark);
  }

  nav.nav-dark .nav-links a:hover {
    color: var(--color-gold);
  }

  nav.nav-scrolled {
    background: var(--color-bg-default);
    border-bottom-color: var(--color-gold-alpha-20);
  }

  nav.nav-scrolled .social-link,
  nav.nav-scrolled .nav-links a {
    color: var(--color-text-primary);
  }

  nav.nav-scrolled .nav-links a:hover {
    color: var(--color-gold-on-light);
  }

  nav.nav-dark .mobile-toggle span {
    background: var(--color-gold);
  }

  nav.nav-scrolled .mobile-toggle span {
    background: var(--color-text-primary);
  }

  .nav-container {
    max-width: var(--container-wide-max-width);
    margin: 0 auto;
    padding: var(--space-md) var(--space-lg);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-lg);
  }

  .nav-left {
    display: flex;
    align-items: center;
    justify-self: start;
  }

  .nav-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    justify-self: center;
  }

  .nav-center .nav-links {
    margin: 0;
    padding: 0;
  }

  .nav-right {
    display: flex;
    align-items: center;
    justify-self: end;
  }

  .nav-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-logo-link .nav-logo {
    display: block;
    height: 2.25rem;
    width: auto;
    max-width: 140px;
    object-fit: contain;
  }

  .nav-logo-link .primary-image {
    display: block;
  }

  .nav-logo-link .secondary-image {
    display: none;
  }

  nav.nav-scrolled .nav-logo-link .primary-image {
    display: none;
  }

  nav.nav-scrolled .nav-logo-link .secondary-image {
    display: block;
  }

  .nav-social {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .social-link {
    transition: color var(--transition-base), opacity var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.85;
    min-width: 44px;
    min-height: 44px;
  }

  .social-link:hover {
    opacity: 1;
    color: var(--color-gold);
  }

  .nav-links {
    display: flex;
    gap: var(--space-xl);
    list-style: none;
    font-family: var(--font-sans);
  }

  .nav-links a {
    text-decoration: none;
    font-weight: 400;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    transition: all var(--transition-base);
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: var(--border-width-thin);
    background: var(--color-gold);
    transition: width var(--transition-base);
  }

  .nav-links a:hover {
    color: var(--color-gold);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  .nav-cta a {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem var(--space-lg);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-xs);
    transition: all var(--transition-base);
    min-height: 44px;
    border-radius: var(--radius-md);
  }

  .nav-cta a:hover {
    background: var(--color-gold-light);
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    align-items: center;
  }

  .mobile-toggle span {
    width: 25px;
    height: 2px;
    transition: background var(--transition-base);
  }

  .mobile-toggle.active span:nth-child(1) {
    transform: rotate(45deg) translate(7px, 7px);
  }

  .mobile-toggle.active span:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active span:nth-child(3) {
    transform: rotate(-45deg) translate(7px, -7px);
  }

  .mobile-menu {
    display: none;
    background: var(--color-bg-default);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
    padding: var(--space-lg);
  }

  .mobile-menu.active {
    display: block;
  }

  .mobile-nav-links {
    list-style: none;
    margin-bottom: var(--space-lg);
  }

  .mobile-nav-links li {
    margin-bottom: var(--space-xs);
  }

  .mobile-nav-links a {
    color: var(--color-text-primary);
    text-decoration: none;
    font-weight: 400;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-family: var(--font-sans);
    transition: color var(--transition-base);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .mobile-nav-links a:hover {
    color: var(--color-gold);
  }

  .mobile-cta a {
    display: block;
    text-align: center;
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    min-height: 44px;
  }

  .mobile-social {
    display: flex;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  /* Mobile menu always has light bg – icons must stay dark (nav-dark uses white) */
  nav .mobile-menu .mobile-social .social-link {
    color: var(--color-text-primary);
  }

  nav .mobile-menu .mobile-social .social-link:hover {
    color: var(--color-gold-on-light);
  }

  .mobile-only {
    display: none;
  }

  .desktop-only {
    display: flex;
  }

  @media (max-width: 768px) {
    .desktop-only {
      display: none;
    }

    .mobile-only {
      display: flex;
    }

    .nav-container {
      grid-template-columns: auto 1fr;
      gap: var(--space-sm);
    }

    .mobile-toggle {
      display: flex;
    }

    .nav-logo-link.mobile-only {
      justify-self: center;
    }

    .nav-logo-link.mobile-only .nav-logo {
      height: 1.85rem;
      max-width: 120px;
    }

    .nav-logo-link.mobile-only .secondary-image {
      height: 1.85rem;
      max-width: 120px;
    }
  }
</style>

<script define:vars={{ menuOpenLabel: ui.menuOpen ?? 'Menü öffnen', menuCloseLabel: ui.menuClose ?? 'Menü schließen' }}>
  function initNav() {
  const toggle = document.querySelector('.mobile-toggle');
  const mobileMenu = document.querySelector('.mobile-menu');
  const nav = document.getElementById('mainNav');
  if (!toggle || !mobileMenu || !nav) return;

  function setMenuOpen(open) {
    if (!toggle || !mobileMenu) return;
    toggle.classList.toggle('active', open);
    mobileMenu.classList.toggle('active', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? menuCloseLabel : menuOpenLabel);

    if (open) {
      const firstLink = mobileMenu.querySelector('a, button');
      firstLink?.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setMenuOpen(!isOpen);
  });

  document.addEventListener('keydown', (e) => {
    if (!toggle || !mobileMenu) return;
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';

    if (e.key === 'Escape' && isOpen) {
      setMenuOpen(false);
      toggle.focus();
      return;
    }

    if (e.key === 'Tab' && isOpen) {
      const focusable = [toggle, ...mobileMenu.querySelectorAll('a, button')];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });

  const mobileLinks = document.querySelectorAll('.mobile-nav-links a, .mobile-cta a');
  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
  }

  function updateNavScroll() {
    const n = document.getElementById('mainNav');
    if (n) n.classList.toggle('nav-scrolled', window.scrollY > 60);
  }

  // Watch a zero-height sentinel 60px down the page instead of running a
  // handler on every scroll frame: the browser reports the crossing off the
  // main thread, so scrolling no longer triggers a style recalc per frame.
  function watchScrollState() {
    const nav = document.getElementById('mainNav');
    if (!nav) return;
    if (!('IntersectionObserver' in window)) {
      updateNavScroll();
      window.addEventListener('scroll', updateNavScroll, { passive: true });
      return;
    }

    const sentinel = document.createElement('div');
    sentinel.setAttribute('aria-hidden', 'true');
    sentinel.style.cssText = 'position:absolute;top:60px;left:0;width:1px;height:1px;pointer-events:none;';
    document.body.prepend(sentinel);

    new IntersectionObserver(
      ([entry]) => nav.classList.toggle('nav-scrolled', !entry.isIntersecting),
      { threshold: 0 }
    ).observe(sentinel);
  }

  function boot() {
    initNav();
    updateNavScroll();
    watchScrollState();
  }

  function scheduleBoot() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(boot, { timeout: 100 });
    } else {
      setTimeout(boot, 0);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleBoot);
  } else {
    scheduleBoot();
  }

  window.addEventListener('pageshow', (e) => {
    if (e.persisted) updateNavScroll();
  });
</script>

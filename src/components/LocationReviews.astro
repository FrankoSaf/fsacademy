---
interface Props {
  title: string;
  items: Array<{ name: string; text: string; instrument: string }>;
  instrumentFilter?: string;
}

const { title, items, instrumentFilter } = Astro.props;

const filtered = instrumentFilter
  ? items.filter((r) => r.instrument === instrumentFilter)
  : items;
---

{filtered.length > 0 && (
  <section class="location-reviews" aria-labelledby="location-reviews-heading">
    <div class="reviews-container">
      <div class="accent-line"></div>
      <p id="location-reviews-heading" class="reviews-heading">{title}</p>
      <div class="reviews-grid">
        {filtered.map((t) => (
          <blockquote class="review-card">
            <p>„{t.text}"</p>
            <footer>
              <cite>— {t.name}</cite>
              <span class="instrument">{t.instrument}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .location-reviews {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-alt);
  }

  .reviews-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .reviews-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-4xl);
    font-weight: 600;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .review-card {
    background: var(--color-surface);
    padding: var(--space-2xl);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-gold);
    margin: 0;
  }

  .review-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .review-card footer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .review-card cite {
    font-style: normal;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .review-card .instrument {
    font-size: var(--text-sm);
    color: var(--color-gold-on-light);
  }

  @media (max-width: 767px) {
    .location-reviews {
      padding: var(--space-4xl) var(--space-md);
    }
  }
</style>

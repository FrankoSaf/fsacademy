---
import contentRaw from '../../content/landing.json';

interface Testimonial {
  name: string;
  text: string;
  instrument: string;
}

interface Content {
  testimonials?: {
    title?: string;
    items?: Testimonial[];
  };
}

const content = contentRaw as Content;
const testimonials = content.testimonials?.items ?? [];
const title = content.testimonials?.title ?? 'Was unsere Schüler sagen';
---

{testimonials.length > 0 && (
  <section class="testimonials reveal" aria-labelledby="testimonials-heading">
    <div class="testimonials-container">
      <div class="accent-line"></div>
      <h2 id="testimonials-heading">{title}</h2>
      <div class="testimonials-grid">
        {testimonials.map((t) => (
          <blockquote class="testimonial-card">
            <p>„{t.text}"</p>
            <footer>
              <cite>— {t.name}</cite>
              <span class="instrument">{t.instrument}</span>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .testimonials {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-alt);
  }

  .testimonials-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .testimonials h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-4xl);
    font-weight: 600;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .testimonial-card {
    background: var(--color-surface);
    padding: var(--space-2xl);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-gold);
    margin: 0;
  }

  .testimonial-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-md);
    font-style: italic;
  }

  .testimonial-card footer {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .testimonial-card cite {
    font-style: normal;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .testimonial-card .instrument {
    font-size: var(--text-sm);
    color: var(--color-gold-on-light);
  }

  @media (max-width: 767px) {
    .testimonials {
      padding: var(--space-4xl) var(--space-md);
    }
  }
</style>

---
import contentRaw from '../../content/landing.json';

interface CTAContent {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonLink: string;
}

interface Content {
  cta: CTAContent;
}

const content = contentRaw as Content;
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="cta-container">
    <p id="cta-heading" class="cta-heading">{content.cta.title}</p>
    <p>{content.cta.subtitle}</p>
    <a href={content.cta.buttonLink} class="cta-button" aria-label={content.cta.buttonText} target={content.cta.buttonLink.startsWith('http') ? '_blank' : undefined} rel={content.cta.buttonLink.startsWith('http') ? 'noopener noreferrer' : undefined}>
      {content.cta.buttonText}
    </a>
  </div>
</section>

<style>
  .cta {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-gold);
  }

  .cta-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    text-align: center;
  }

  .cta .cta-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    color: var(--color-black);
    font-weight: 400;
    margin-bottom: var(--space-2xl);
    letter-spacing: var(--tracking-tight);
  }

  .cta p {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-lg), 3vw, var(--text-xl));
    color: var(--color-black);
    font-weight: 400;
    margin-bottom: var(--space-3xl);
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.5;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-3xl);
    min-width: 44px;
    background: var(--color-black);
    color: var(--color-white);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-base);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-black);
    min-height: 48px;
    min-width: 180px;
    border-radius: var(--radius-md);
  }

  .cta-button:hover {
    background: transparent;
    color: var(--color-black);
    border-color: var(--color-black);
  }

  @media (max-width: 768px) {
    .cta {
      padding: var(--space-4xl) var(--space-md);
    }

    .cta .cta-heading {
      margin-bottom: var(--space-lg);
    }

    .cta p {
      margin-bottom: var(--space-2xl);
    }
  }
</style>

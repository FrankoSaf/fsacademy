---
import globals from '../../content/globals.json';
import ui from '../../content/ui.json';

const probestundeUrl = (globals as { probestundeUrl?: string }).probestundeUrl ?? 'https://www.axinio.app/booking/forms/trial/fc60f65c-2a6f-49dd-8809-c41246cca534/';
const stickyCta = (ui as { stickyCta?: { text?: string; ariaLabel?: string } }).stickyCta ?? {};
const ctaText = stickyCta.text ?? 'Probestunde';
const ariaLabel = stickyCta.ariaLabel ?? 'Probestunde vereinbaren';
---
<a
  href={probestundeUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="sticky-cta-float"
  aria-label={ariaLabel}
>
  <span class="sticky-cta-text">{ctaText}</span>
  <span class="sticky-cta-arrow" aria-hidden="true">→</span>
</a>

<style>
  .sticky-cta-float {
    position: fixed;
    /* Sits above the WhatsApp bubble in a shared right-hand stack rather than
       in the opposite corner: at 360px the two used to squeeze the viewport
       from both sides and cover the footer. --floating-cta-offset is defined in
       variables.css so the cookie banner can push both up when it is showing. */
    bottom: calc(var(--floating-cta-offset) + 56px + var(--space-sm));
    right: var(--space-lg);
    z-index: 9997;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 4px 12px rgba(205, 178, 135, 0.4);
    transition: background var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }
  .sticky-cta-float:hover {
    background: var(--color-gold-light);
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(205, 178, 135, 0.5);
  }
  .sticky-cta-arrow {
    font-size: 1.1em;
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta-float:hover {
      transform: none;
    }
  }
</style>

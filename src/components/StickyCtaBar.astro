---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const hideOnContact = pathname === '/kontakt' || pathname.startsWith('/kontakt/');
if (hideOnContact) {
  return null;
}
---
<a
  href="/kontakt"
  class="sticky-cta-float"
  aria-label="Probestunde vereinbaren"
>
  <span class="sticky-cta-text">Probestunde</span>
  <span class="sticky-cta-arrow" aria-hidden="true">→</span>
</a>

<style>
  .sticky-cta-float {
    position: fixed;
    bottom: var(--space-lg);
    left: var(--space-lg);
    z-index: 9997;
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    padding: var(--space-sm) var(--space-lg);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 4px 12px rgba(205, 178, 135, 0.4);
    transition: background var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
  }
  .sticky-cta-float:hover {
    background: var(--color-gold-light);
    transform: scale(1.05);
    box-shadow: 0 6px 20px rgba(205, 178, 135, 0.5);
  }
  .sticky-cta-arrow {
    font-size: 1.1em;
  }
  @media (prefers-reduced-motion: reduce) {
    .sticky-cta-float:hover {
      transform: none;
    }
  }
</style>

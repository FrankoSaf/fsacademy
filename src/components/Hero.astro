---
import contentRaw from '../../content/landing.json';

interface HeroContent {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonLink: string;
  image: string;
}

interface Content {
  hero: HeroContent;
}

const content = contentRaw as Content;
const hero = content.hero;
---

<section class="hero" aria-labelledby="hero-heading">
  <picture>
    <source
      type="image/webp"
      srcset={`${hero.image}?w=640&q=75&fm=webp 640w, ${hero.image}?w=960&q=75&fm=webp 960w, ${hero.image}?w=1280&q=80&fm=webp 1280w, ${hero.image}?w=1440&q=80&fm=webp 1440w`}
      sizes="(min-width: 1440px) 1440px, 100vw"
    />
    <img
      src={`${hero.image}?w=960&q=80`}
      srcset={`${hero.image}?w=640&q=75 640w, ${hero.image}?w=960&q=75 960w, ${hero.image}?w=1280&q=80 1280w, ${hero.image}?w=1440&q=80 1440w`}
      sizes="(min-width: 1440px) 1440px, 100vw"
      width="1440"
      height="810"
      alt=""
      role="presentation"
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
  </picture>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="accent-line"></div>
    <h1 id="hero-heading">{hero.title}</h1>
    <p>{hero.subtitle}</p>
    <a href={hero.buttonLink} class="hero-cta">{hero.buttonText}</a>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.55);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: var(--space-2xl);
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 700;
    margin-bottom: var(--space-lg);
    color: var(--color-text-on-dark);
    line-height: 1.15;
  }

  .hero p {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    color: var(--color-gold);
    margin-bottom: var(--space-3xl);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1.5;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-3xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 48px;
    min-width: 200px;
    border-radius: var(--radius-md);
  }

  .hero-cta:hover {
    background: transparent;
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-xl);
  }
</style>

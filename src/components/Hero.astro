---
import contentRaw from '../../content/landing.json';
import ResponsiveImage from './ResponsiveImage.astro';

interface HeroContent {
  title: string;
  subtitle: string;
  buttonText: string;
  buttonLink: string;
  image: string;
}

interface Content {
  hero: HeroContent;
}

const content = contentRaw as Content;
const hero = content.hero;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-picture-wrap">
    <ResponsiveImage
      src={hero.image}
      alt="Fine Sound Academy Musikschule – Klavier, Gitarre, Gesang, Bass und Schlagzeug in Düsseldorf und Neuss"
      preset="hero"
      loading="eager"
      fetchpriority="high"
      class="hero-image"
    />
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="accent-line"></div>
    <h1 id="hero-heading">{hero.title}</h1>
    <p>{hero.subtitle}</p>
    <a href={hero.buttonLink} class="hero-cta">{hero.buttonText}</a>
  </div>
</section>

<style>
  .hero-picture-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-picture-wrap :global(picture),
  .hero-picture-wrap :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.55);
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding: clamp(var(--space-md), 5vw, var(--space-2xl));
    max-width: 100%;
    min-width: 0;
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.75rem, 7vw, 5.5rem);
    font-weight: 700;
    margin-bottom: var(--space-lg);
    color: var(--color-text-on-dark);
    line-height: 1.15;
  }

  .hero p {
    font-size: clamp(var(--text-base), 2vw, var(--text-lg));
    color: var(--color-gold);
    margin-bottom: var(--space-3xl);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 400;
    line-height: 1.5;
  }

  .hero-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-3xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 48px;
    min-width: 200px;
    border-radius: var(--radius-md);
  }

  .hero-cta:hover {
    background: transparent;
    color: var(--color-gold);
    border-color: var(--color-gold);
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-xl);
  }
</style>

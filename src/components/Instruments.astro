---
import contentRaw from '../../content/landing.json';

interface Instrument {
  name: string;
  icon: string;
  description: string;
}

interface InstrumentsContent {
  title: string;
  subtitle: string;
  items: Instrument[];
}

interface Content {
  instruments: InstrumentsContent;
}

const content = contentRaw as Content;

// Recognizable instrument icons – clean, elegant silhouettes
const instrumentIcons: Record<string, string> = {
  piano:
    '<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="22" width="52" height="28" rx="2"/><line x1="14" y1="22" x2="14" y2="50"/><line x1="22" y1="22" x2="22" y2="50"/><line x1="30" y1="22" x2="30" y2="50"/><line x1="38" y1="22" x2="38" y2="50"/><line x1="46" y1="22" x2="46" y2="50"/><line x1="54" y1="22" x2="54" y2="50"/><rect x="10" y="22" width="5" height="18" fill="currentColor" opacity="0.35"/><rect x="26" y="22" width="5" height="18" fill="currentColor" opacity="0.35"/><rect x="42" y="22" width="5" height="18" fill="currentColor" opacity="0.35"/></svg>',

  guitar:
    '<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M32 8v8l-4 4"/><path d="M32 8v8l4 4"/><path d="M32 16c-8 0-16 6-16 14v14c0 4 4 8 16 8s16-4 16-8V30c0-8-8-14-16-14z"/><ellipse cx="32" cy="30" rx="10" ry="6"/><circle cx="32" cy="38" r="2.5" fill="currentColor" opacity="0.5"/><path d="M28 12h8"/></svg>',

  bass:
    '<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M18 54V18c0-2 2-4 4-4h20c2 0 4 2 4 4v36"/><path d="M18 54h28v4H18z"/><rect x="22" y="22" width="20" height="26" rx="2"/><line x1="28" y1="20" x2="28" y2="50"/><line x1="32" y1="20" x2="32" y2="50"/><line x1="36" y1="20" x2="36" y2="50"/><circle cx="32" cy="34" r="3" fill="currentColor" opacity="0.4"/></svg>',

  vocals:
    '<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="32" cy="22" rx="10" ry="14"/><path d="M32 36v14"/><path d="M22 50h20"/><path d="M30 50v6h4v-6"/><path d="M24 18c2 2 6 4 8 4s6-2 8-4" opacity="0.6"/><path d="M22 26c3 2 7 4 10 4s7-2 10-4" opacity="0.4"/></svg>',

  drums:
    '<svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="32" cy="40" rx="16" ry="10"/><path d="M16 40v6c0 2 7 4 16 4s16-2 16-4v-6"/><circle cx="24" cy="34" r="8"/><path d="M16 34h16"/><path d="M24 26v16"/><circle cx="40" cy="34" r="5" opacity="0.85"/><path d="M35 34h10"/><path d="M40 29v10"/></svg>',
};
---

<section id="instruments" class="instruments reveal" aria-labelledby="instruments-heading">
  <div class="instruments-container">
    <div class="instruments-header">
      <div class="accent-line"></div>
      <h2 id="instruments-heading">{content.instruments.title}</h2>
      <p class="subtitle">{content.instruments.subtitle}</p>
    </div>

    <div class="instruments-grid">
      {
        content &&
          content.instruments.items.map((instrument, i) => (
            <div class={`instrument-card reveal reveal-delay-${Math.min(i + 1, 4)}`}>
              <div class="instrument-icon" aria-hidden="true">
                <Fragment set:html={instrumentIcons[instrument.icon]} />
              </div>
              <h3>{instrument.name}</h3>
              <p>{instrument.description}</p>
            </div>
          ))
      }
    </div>
  </div>
</section>

<style>
  .instruments {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .instruments-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .instruments-header {
    text-align: center;
    margin-bottom: var(--space-5xl);
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .instruments-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-gold-on-light);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 300;
  }

  .instruments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-3xl);
  }

  .instrument-card {
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    background: var(--color-surface);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition-base), transform var(--transition-base), border-color var(--transition-base);
  }

  .instrument-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
    border-color: var(--color-gold-alpha-20);
  }

  .instrument-icon {
    color: var(--color-gold);
    margin-bottom: var(--space-md);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-base);
  }

  .instrument-card:hover .instrument-icon {
    transform: scale(1.08);
  }

  .instrument-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .instrument-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .instruments {
      padding: var(--space-4xl) var(--space-md);
    }

    .instruments-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>

---
import contentRaw from '../../content/landing.json';

interface Instrument {
  name: string;
  icon: string;
  description: string;
}

interface InstrumentsContent {
  title: string;
  subtitle: string;
  items: Instrument[];
}

interface Content {
  instruments: InstrumentsContent;
}

const content = contentRaw as Content;

// Simple geometric icons
const instrumentIcons: Record<string, string> = {
  bass: '<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 4v16M11 4v16M7 8h4M7 12h4M7 16h4"/></svg>',

  guitar:
    '<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="14" r="5"/><path d="M12 4v5M9 7l6-3M15 7l-6-3"/></svg>',

  piano:
    '<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="8" width="18" height="10"/><line x1="7" y1="8" x2="7" y2="18"/><line x1="11" y1="8" x2="11" y2="18"/><line x1="15" y1="8" x2="15" y2="18"/><line x1="19" y1="8" x2="19" y2="18"/></svg>',

  vocals:
    '<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3"/><path d="M9 8v4a3 3 0 0 0 6 0V8"/><line x1="12" y1="15" x2="12" y2="20"/><line x1="9" y1="20" x2="15" y2="20"/></svg>',

  drums:
    '<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><line x1="8" y1="8" x2="6" y2="6"/><line x1="16" y1="8" x2="18" y2="6"/></svg>',
};
---

<section id="instruments" class="instruments" aria-labelledby="instruments-heading">
  <div class="instruments-container">
    <div class="instruments-header">
      <div class="accent-line"></div>
      <h2 id="instruments-heading">{content.instruments.title}</h2>
      <p class="subtitle">{content.instruments.subtitle}</p>
    </div>

    <div class="instruments-grid">
      {
        content &&
          content.instruments.items.map((instrument) => (
            <div class="instrument-card">
              <div class="instrument-icon" aria-hidden="true">
                <Fragment set:html={instrumentIcons[instrument.icon]} />
              </div>
              <h3>{instrument.name}</h3>
              <p>{instrument.description}</p>
            </div>
          ))
      }
    </div>
  </div>
</section>

<style>
  .instruments {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .instruments-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .instruments-header {
    text-align: center;
    margin-bottom: var(--space-5xl);
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .instruments-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-gold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 300;
  }

  .instruments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-3xl);
  }

  .instrument-card {
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    background: var(--color-surface);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .instrument-icon {
    color: var(--color-gold);
    margin-bottom: var(--space-md);
  }

  .instrument-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .instrument-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .instruments {
      padding: var(--space-4xl) var(--space-md);
    }

    .instruments-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }
</style>

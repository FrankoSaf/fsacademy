---
import contentRaw from '../../content/landing.json';

interface Instrument {
  name: string;
  icon: string;
  description: string;
}

interface InstrumentsContent {
  title: string;
  subtitle: string;
  items: Instrument[];
}

interface Content {
  instruments: InstrumentsContent;
}

const content = contentRaw as Content;

const iconToSlug: Record<string, string> = {
  piano: 'klavier',
  guitar: 'gitarre',
  bass: 'bass',
  vocals: 'gesang',
  drums: 'schlagzeug',
};

// Map slug to SVG filename (schlagzeug → schalgzeug.svg due to filename typo)
const slugToIconFile: Record<string, string> = {
  klavier: 'klavier.svg',
  gitarre: 'gitarre.svg',
  bass: 'bass.svg',
  gesang: 'gesang.svg',
  schlagzeug: 'schalgzeug.svg',
};
---

<section id="instruments" class="instruments" aria-labelledby="instruments-heading">
  <div class="instruments-container">
    <div class="instruments-header">
      <div class="accent-line"></div>
      <h2 id="instruments-heading">{content.instruments.title}</h2>
      <p class="subtitle">{content.instruments.subtitle}</p>
    </div>

    <div class="instruments-grid">
      {
        content &&
          content.instruments.items.map((instrument) => {
            const slug = iconToSlug[instrument.icon] ?? instrument.icon;
            const iconFile = slugToIconFile[slug] ?? `${slug}.svg`;
            return (
              <a href={`/unterricht/${slug}`} class="instrument-card">
                <div class="instrument-icon" aria-hidden="true">
                  <img src={`/instrument-icons/${iconFile}`} alt="" width="64" height="64" loading="lazy" />
                </div>
                <h3>{instrument.name}</h3>
                <p>{instrument.description}</p>
              </a>
            );
          })
      }
    </div>
  </div>
</section>

<style>
  .instruments {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .instruments-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .instruments-header {
    text-align: center;
    margin-bottom: var(--space-5xl);
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .instruments-header h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .subtitle {
    font-size: var(--text-lg);
    color: var(--color-gold-on-light);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 300;
  }

  .instruments-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-lg);
  }

  .instrument-card {
    display: block;
    text-align: center;
    padding: var(--space-2xl) var(--space-lg);
    background: var(--color-surface);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: box-shadow var(--transition-base), border-color var(--transition-base);
    text-decoration: none;
    color: inherit;
    flex: 1 1 180px;
    max-width: 220px;
  }

  .instrument-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-gold-alpha-40);
  }

  .instrument-icon {
    color: var(--color-gold);
    margin-bottom: var(--space-md);
  }

  .instrument-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    font-weight: 600;
  }

  .instrument-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .instruments {
      padding: var(--space-4xl) var(--space-md);
    }

    .instruments-grid {
      flex-direction: row;
      justify-content: center;
    }

    .instrument-card {
      flex: 1 1 140px;
      max-width: none;
    }
  }
</style>

---
interface Props {
  school: 'duesseldorf' | 'neuss';
}

const { school } = Astro.props;

// Dynamic import based on school
const schoolData = await import(`../data/${school}.json`);
const content = schoolData.default;
---

<section class="about">
  <div class="about-container">
    <div class="about-content">
      <h2>{content.about.title}</h2>
      <div class="about-text">
        {
          content.about.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
      <a href={content.about.buttonLink} class="about-button">
        {content.about.buttonText}
      </a>
    </div>
    <div class="about-image">
      <picture>
        <source
          srcset={`${content.about.image}?w=600&q=80 600w, ${content.about.image}?w=900&q=80 900w`}
          sizes="(min-width: 768px) 50vw, 100vw"
        />
        <img
          src={`${content.about.image}?w=600&q=80`}
          alt={content.about.imageAlt}
          loading="lazy"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .about-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5xl);
    align-items: center;
  }

  .about-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-2xl);
    font-weight: 700;
    line-height: 1.3;
  }

  .about-text p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.8;
  }

  .about-button {
    display: inline-block;
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-2xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
  }

  .about-button:hover {
    background: transparent;
    color: var(--color-gold);
  }

  .about-image {
    width: 100%;
    height: 100%;
    min-height: 400px;
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .about {
      padding: var(--space-4xl) var(--space-md);
    }

    .about-container {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .about-image {
      min-height: 300px;
    }
  }
</style>

---
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  school: 'duesseldorf' | 'neuss';
}

const { school } = Astro.props;

// Dynamic import based on school
const schoolData = await import(`../../content/${school}.json`);
const raw = schoolData.default as { about: { title: string; paragraphs: unknown; buttonLink: string; buttonText: string; image: string; imageAlt: string } };
const content = {
  ...raw,
  about: {
    ...raw.about,
    paragraphs: (() => {
      const p = raw.about.paragraphs;
      if (!Array.isArray(p)) return [];
      return p.map((item: unknown) =>
        typeof item === 'string' ? item : (item && (item as { paragraph?: string }).paragraph) || (item as { p?: string }).p || ''
      );
    })(),
  },
};
---

<section class="about" aria-labelledby={`about-heading-${school}`}>
  <div class="about-container">
    <div class="about-content">
      <h2 id={`about-heading-${school}`}>{content.about.title}</h2>
      <div class="about-text">
        {
          content.about.paragraphs.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))
        }
      </div>
      <a href={content.about.buttonLink} class="about-button" target={content.about.buttonLink.startsWith('http') ? '_blank' : undefined} rel={content.about.buttonLink.startsWith('http') ? 'noopener noreferrer' : undefined}>
        {content.about.buttonText}
      </a>
    </div>
    <div class="about-image">
      <ResponsiveImage
        src={content.about.image}
        alt={content.about.imageAlt}
        preset="about"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .about {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .about-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5xl);
    align-items: center;
  }

  .about-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-2xl);
    font-weight: 700;
    line-height: 1.3;
  }

  .about-text p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.8;
  }

  .about-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-2xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 48px;
    border-radius: var(--radius-sm);
  }

  .about-button:hover {
    background: transparent;
    color: var(--color-gold-on-light);
  }

  .about-image {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .about {
      padding: var(--space-4xl) var(--space-md);
    }

    .about-container {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }

    .about-image {
      min-height: 300px;
    }
  }
</style>

---
import contentRaw from '../../content/landing.json';
import { href, linkAttrs } from '../lib/links';
import { socialIcon } from '../lib/social-icons';
import { LOCATIONS, CONTACT } from '../lib/site';

interface FooterLink {
  text: string;
  url: string;
  highlight?: boolean;
}

interface FooterContent {
  logo: {
    image: string;
    alt: string;
    link: string;
  };
  navigation: FooterLink[];
  legal: FooterLink[];
  cta: {
    text: string;
    url: string;
  };
}

interface Content {
  footer: FooterContent;
  navigation?: { socialMedia?: { name: string; url: string; icon: string }[] };
}

const content = contentRaw as Content;
const socials = (content?.navigation?.socialMedia ?? []).filter((s) => socialIcon(s.icon));
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <a href={href(content.footer.logo.link)} class="footer-logo-wrap" aria-label={content.footer.logo.alt}>
        <img
          src={content.footer.logo.image}
          alt={content.footer.logo.alt}
          width="200"
          height="52"
          loading="lazy"
          decoding="async"
          class="footer-logo"
        />
      </a>
      <a href={href(content.footer.cta.url)} class="footer-cta" {...linkAttrs(content.footer.cta.url)}>
        {content.footer.cta.text}
      </a>
    </div>

    {/* NAP block: name, address and phone per location. Search engines read
        this as a local-business signal, and it saves visitors a page hop to
        find an address or dial the school. */}
    <div class="footer-nap">
      {LOCATIONS.map((loc) => (
        <address class="footer-nap-item">
          <p class="footer-nap-city">
            <a href={href(`/${loc.slug}`)}>{`Musikschule ${loc.name}`}</a>
          </p>
          <p>{loc.street}</p>
          <p>{`${loc.postalCode} ${loc.name}`}</p>
        </address>
      ))}
      <address class="footer-nap-item">
        <p class="footer-nap-city">Kontakt</p>
        <p><a href={`tel:${CONTACT.phone}`}>{CONTACT.phoneDisplay}</a></p>
        <p><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
      </address>
    </div>

    <div class="footer-social">
      {socials.map((social) => (
        <a
          href={social.url}
          class="footer-social-link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={social.name}
        >
          <Fragment set:html={socialIcon(social.icon)} />
        </a>
      ))}
    </div>

    {/* One set of links for both breakpoints. This used to be two blocks -
        a desktop pair of lists plus a merged mobile list - which shipped every
        footer link twice in the HTML of all 27 pages. CSS reflows the same
        markup into a single centred column on small screens instead. */}
    <nav class="footer-bottom" aria-label="Footer-Navigation">
      <ul class="footer-links">
        {content.footer.navigation.map((link) => (
          <li>
            <a href={href(link.url)} {...linkAttrs(link.url)}>{link.text}</a>
          </li>
        ))}
      </ul>
      <ul class="footer-links footer-links-legal">
        {content.footer.legal.map((link) => (
          <li>
            <a
              href={href(link.url)}
              class:list={[{ highlight: link.highlight }]}
              {...linkAttrs(link.url)}
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="footer-copyright">© {year} {CONTACT.name}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-alt);
    padding: var(--space-5xl) var(--space-lg) var(--space-2xl);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .footer-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .footer-social {
    display: flex;
    gap: var(--space-md);
    align-items: center;
  }

  .footer-social-link {
    color: var(--color-text-primary);
    opacity: 0.85;
    transition: color var(--transition-base), opacity var(--transition-base);
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
  }

  .footer-social-link:hover {
    opacity: 1;
    color: var(--color-gold-on-light);
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-lg);
    padding-bottom: var(--space-2xl);
    margin-bottom: var(--space-2xl);
    border-bottom: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .footer-nap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .footer-nap-item {
    font-style: normal;
  }

  .footer-nap-item p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin: 0;
  }

  /* Type selector included so this outranks `.footer-nap-item p` above
     without reaching for !important. */
  .footer-nap-item p.footer-nap-city {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--color-text-primary);
    font-size: var(--text-base);
    margin-bottom: var(--space-xs);
  }

  .footer-nap-item a {
    color: inherit;
    text-decoration: none;
  }

  .footer-nap-item a:hover {
    color: var(--color-gold-on-light);
    text-decoration: underline;
  }

  .footer-logo-wrap {
    display: inline-block;
    background: var(--color-bg-dark);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    transition: opacity var(--transition-base);
  }

  .footer-logo-wrap:hover {
    opacity: 0.9;
  }

  .footer-logo {
    display: block;
    max-width: 200px;
    width: 100%;
    height: auto;
    vertical-align: middle;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-2xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 48px;
    border-radius: var(--radius-sm);
  }

  .footer-cta:hover {
    background: transparent;
    color: var(--color-gold-on-light);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-lg) var(--space-4xl);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg) var(--space-2xl);
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: var(--color-text-primary);
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 400;
    transition: color var(--transition-base);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .footer-links a:hover {
    color: var(--color-gold-on-light);
  }

  .footer-links a.highlight {
    color: var(--color-gold-on-light);
    font-weight: 600;
  }

  .footer-copyright {
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  @media (max-width: 767px) {
    .footer {
      padding: var(--space-4xl) var(--space-md) var(--space-2xl);
    }

    .footer-top {
      flex-direction: column;
      gap: var(--space-2xl);
      text-align: center;
      padding-bottom: var(--space-2xl);
      margin-bottom: var(--space-2xl);
    }

    .footer-logo-wrap {
      margin: 0 auto;
    }

    .footer-logo {
      max-width: 160px;
    }

    .footer-social {
      justify-content: center;
    }

    .footer-nap {
      text-align: center;
      gap: var(--space-lg);
    }

    /* Same markup as desktop, stacked into one centred column. */
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      gap: var(--space-xs);
      text-align: center;
    }

    .footer-links {
      flex-direction: column;
      align-items: center;
      gap: var(--space-xs);
    }

    .footer-links a {
      justify-content: center;
      padding: var(--space-xs) 0;
    }

    .footer-copyright {
      text-align: center;
    }
  }
</style>

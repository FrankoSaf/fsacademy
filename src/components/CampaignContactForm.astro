---
interface Props {
  instrumentValue: string;
  cityValue: string;
}

const { instrumentValue, cityValue } = Astro.props;

const instruments = [
  { value: 'Gesang', label: 'Gesang' },
  { value: 'Klavier', label: 'Klavier' },
  { value: 'Gitarre', label: 'Gitarre' },
  { value: 'Bass', label: 'Bass' },
  { value: 'Schlagzeug', label: 'Schlagzeug' },
];

const locations = [
  { value: 'Neuss', label: 'Neuss' },
  { value: 'Düsseldorf', label: 'Düsseldorf' },
];
---

<section class="campaign-contact" aria-label="Kontaktformular">
  <div class="form-container">
    <h2 id="campaign-contact-heading">Kontaktieren Sie uns</h2>
    <form
      method="POST"
      action="/.netlify/functions/contact-submit"
      class="contact-form"
    >
      <div class="form-row">
        <div class="form-group form-group-full">
          <label for="campaign-name">Vollständiger Name <span class="required">*</span></label>
          <input type="text" id="campaign-name" name="name" required autocomplete="name" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group form-group-full">
          <label for="campaign-email">E-Mail-Adresse <span class="required">*</span></label>
          <input type="email" id="campaign-email" name="email" required autocomplete="email" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group form-group-full">
          <label for="campaign-phone">Telefonnummer <span class="required">*</span></label>
          <input type="tel" id="campaign-phone" name="phone" required pattern="^[0-9\s+\-().]+$" autocomplete="tel" />
        </div>
      </div>
      <div class="form-row form-row-half">
        <div class="form-group">
          <label for="campaign-interest">Ich interessiere mich für <span class="required">*</span></label>
          <select id="campaign-interest" name="interest" required>
            {
              instruments.map((opt) => (
                <option value={opt.value} selected={opt.value === instrumentValue}>{opt.label}</option>
              ))
            }
          </select>
        </div>
        <div class="form-group">
          <label for="campaign-location">Standort <span class="required">*</span></label>
          <select id="campaign-location" name="location" required>
            {
              locations.map((opt) => (
                <option value={opt.value} selected={opt.value === cityValue}>{opt.label}</option>
              ))
            }
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group form-group-full">
          <label for="campaign-message">Ihre Nachricht</label>
          <textarea
            id="campaign-message"
            name="message"
            rows="5"
            placeholder="Terminwünsche, Vorkenntnisse, weitere Anmerkungen..."
          ></textarea>
        </div>
      </div>
      <div class="form-row form-row-consent">
        <div class="form-group form-group-checkbox">
          <label class="checkbox-label">
            <input type="checkbox" name="consent" value="true" required />
            <span>Ich stimme der Übermittlung und Verarbeitung meiner Nachricht zu. <span class="required">*</span></span>
          </label>
        </div>
      </div>
      <div class="form-status" aria-live="polite"></div>
      <div class="form-submit">
        <button type="submit" class="submit-btn">
          <span class="btn-text">Senden</span>
          <span class="btn-loading" aria-hidden="true">
            <svg class="spinner" width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="2" stroke-dasharray="35 12" stroke-linecap="round"/></svg>
            Wird gesendet&hellip;
          </span>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .campaign-contact {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }
  .form-container {
    max-width: 560px;
    margin: 0 auto;
  }
  .form-container h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-2xl);
    font-weight: 600;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }
  .form-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }
  .form-row-half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }
  .form-group { flex: 1; min-width: 0; }
  .form-group-full { flex: 1 1 100%; }
  .form-group label, .checkbox-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }
  .form-group input, .form-group select, .form-group textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    background: var(--color-bg-default);
    border: var(--border-width-thin) solid var(--color-border-input);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-base);
  }
  .form-group input, .form-group select { min-height: 48px; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    border-color: var(--color-border-input-focus);
    outline: none;
  }
  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }
  .required { color: var(--color-gold-on-light); }
  .form-group-checkbox { flex: 1 1 100%; }
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    cursor: pointer;
    font-weight: 400;
    min-height: 44px;
    padding: var(--space-xs) 0;
  }
  .checkbox-label input {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    accent-color: var(--color-gold);
  }
  .form-status {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: 4px;
    display: none;
  }
  .form-status.is-error {
    display: block;
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }
  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-md) var(--space-3xl);
    background: var(--color-gold);
    color: var(--color-black);
    border: var(--border-width-medium) solid var(--color-gold);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    cursor: pointer;
    min-height: 48px;
    border-radius: var(--radius-sm);
    transition: background var(--transition-base), opacity var(--transition-base);
  }
  .submit-btn:hover { background: var(--color-gold-light); }
  .submit-btn:disabled { opacity: 0.7; cursor: not-allowed; }
  .btn-loading { display: none; align-items: center; gap: var(--space-xs); }
  .submit-btn.is-loading .btn-text { display: none; }
  .submit-btn.is-loading .btn-loading { display: inline-flex; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (max-width: 600px) {
    .form-row-half { grid-template-columns: 1fr; }
  }
</style>

<script>
  const form = document.querySelector('.campaign-contact .contact-form') as HTMLFormElement;
  const btn = form?.querySelector('.submit-btn') as HTMLButtonElement;
  const status = form?.querySelector('.form-status') as HTMLElement;

  function setLoading(loading: boolean) {
    if (btn) { btn.disabled = loading; btn.classList.toggle('is-loading', loading); }
  }
  function showError(msg: string) {
    if (status) { status.textContent = msg; status.classList.add('is-error'); status.style.display = ''; }
  }
  function clearError() {
    if (status) { status.textContent = ''; status.classList.remove('is-error'); status.style.display = 'none'; }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();
    setLoading(true);
    try {
      const res = await fetch(form.action || window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form) as any).toString(),
      });
      if (!res.ok) throw new Error(`${res.status}`);
      sessionStorage.setItem('fsa_form_success', '1');
      const params = new URLSearchParams(window.location.search);
      const utmParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const qs = utmParams
        .filter((k) => params.has(k))
        .map((k) => `${k}=${encodeURIComponent(params.get(k) || '')}`)
        .join('&');
      window.location.href = '/kontakt/danke' + (qs ? '?' + qs : '');
    } catch {
      showError('Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.');
    } finally {
      setLoading(false);
    }
  });

</script>

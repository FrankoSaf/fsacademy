---
import BaseLayout from '../layouts/BaseLayout.astro';
import datenschutzData from '../../content/datenschutz.json';

const data = datenschutzData as {
  metaTitle: string;
  metaDescription: string;
  title: string;
  intro: string;
  sections: Array<{ heading: string; subheading?: string; content: string }>;
  lastUpdated: string;
};

function markdownToHtml(md: string): string {
  let html = md
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>');
  const blocks = html.split(/\n\n+/);
  const out: string[] = [];
  for (const block of blocks) {
    const lines = block.split('\n');
    const listItems = lines.filter((l) => l.trimStart().startsWith('- '));
    if (listItems.length === lines.length && listItems.length > 0) {
      out.push('<ul>' + listItems.map((l) => `<li>${l.trimStart().slice(2)}</li>`).join('') + '</ul>');
    } else {
      out.push('<p>' + lines.join('<br>') + '</p>');
    }
  }
  return out.join('');
}
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
>
  <section class="legal-page">
    <div class="legal-container">
      <div class="accent-line"></div>
      <h1>{data.title}</h1>

      <div class="legal-content">
        <p class="intro">{data.intro}</p>

        {data.sections?.map((section) => (
          <>
            <h2>{section.heading}</h2>
            {section.subheading && <h3>{section.subheading}</h3>}
            <Fragment set:html={markdownToHtml(section.content)} />
          </>
        ))}

        <p class="last-updated">{data.lastUpdated}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .legal-page {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
    min-height: 80vh;
  }

  .legal-container {
    max-width: 65ch;
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin-bottom: var(--space-2xl);
  }

  .legal-page h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-3xl);
    font-weight: 700;
  }

  .intro {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3xl);
    font-weight: 500;
  }

  .legal-content h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-text-primary);
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .legal-content h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .legal-content p,
  .legal-content li {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
    line-height: 1.9;
  }

  .legal-content ul {
    margin-left: var(--space-2xl);
    margin-bottom: var(--space-lg);
  }

  .legal-content li {
    margin-bottom: var(--space-sm);
  }

  .legal-content strong {
    font-weight: 600;
  }

  .legal-content a {
    color: var(--color-gold-on-light);
    text-decoration: underline;
  }
  .legal-content a:hover {
    text-decoration: none;
  }

  .last-updated {
    margin-top: var(--space-4xl);
    font-style: italic;
    color: var(--color-text-secondary);
  }

  @media (max-width: 767px) {
    .legal-page {
      padding: var(--space-4xl) var(--space-md);
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Vielen Dank – Fine Sound Academy"
  description="Deine Nachricht wurde erfolgreich gesendet. Wir melden uns in Kürze bei dir."
  noindex={true}
>
  <section class="thank-you-section" aria-labelledby="danke-heading">
    <div class="thank-you-container">
      <div class="success-icon" aria-hidden="true">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><circle cx="24" cy="24" r="22" stroke="var(--color-gold)" stroke-width="2.5"/><path d="M14 25l7 7 13-14" stroke="var(--color-gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <h1 id="danke-heading">Vielen Dank!</h1>
      <p class="thank-you-text">Deine Nachricht wurde erfolgreich gesendet. Wir melden uns in Kürze bei dir.</p>
      <a href="/kontakt" class="back-link">Weitere Nachricht senden</a>
      <a href="/" class="back-link secondary">Zur Startseite</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thank-you-section {
    padding: var(--space-6xl) var(--space-lg);
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thank-you-container {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }
  .success-icon { margin-bottom: var(--space-xl); }
  .thank-you-container h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }
  .thank-you-text {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.7;
    margin-bottom: var(--space-2xl);
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: 0 var(--space-sm) var(--space-sm);
    padding: var(--space-md) var(--space-2xl);
    min-height: 48px;
    border-radius: var(--radius-sm);
    background: var(--color-gold);
    color: var(--color-black);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    text-decoration: none;
    transition: background var(--transition-base);
  }
  .back-link:hover { background: var(--color-gold-light); }
  .back-link.secondary {
    background: transparent;
    color: var(--color-gold-on-light);
    border: var(--border-width-thin) solid var(--color-gold-on-light);
  }
  .back-link.secondary:hover { background: var(--color-gold); color: var(--color-black); }
</style>

<script define:vars={{}}>
  (function() {
    const STORAGE_KEY = 'fsa_form_success';
    const CONVERSION_FIRED_KEY = 'fsa_conversion_fired';

    const params = new URLSearchParams(window.location.search);
    const fromForm = sessionStorage.getItem(STORAGE_KEY);

    if (!fromForm) {
      window.location.replace('/kontakt');
      return;
    }

    sessionStorage.removeItem(STORAGE_KEY);

    const alreadyFired = sessionStorage.getItem(CONVERSION_FIRED_KEY);
    const gtag = typeof window !== 'undefined' ? (window as any).gtag : null;
    if (!alreadyFired && typeof gtag === 'function') {
      try {
        gtag('event', 'conversion', {
          send_to: window.__FSA_GOOGLE_ADS_CONVERSION__ || undefined,
          value: window.__FSA_CONVERSION_VALUE__ || undefined,
          currency: 'EUR',
        });
        sessionStorage.setItem(CONVERSION_FIRED_KEY, '1');
      } catch (_) {}
    }
  })();
</script>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import instrumentsData from '../../../content/instruments.json';

const iconToSlug: Record<string, string> = {
  piano: 'klavier',
  guitar: 'gitarre',
  bass: 'bass',
  vocals: 'gesang',
  drums: 'schlagzeug',
};

export function getStaticPaths() {
  return [
    { params: { instrument: 'klavier' } },
    { params: { instrument: 'gitarre' } },
    { params: { instrument: 'bass' } },
    { params: { instrument: 'gesang' } },
    { params: { instrument: 'schlagzeug' } },
  ];
}

const { instrument } = Astro.params;
const data = (instrumentsData as Record<string, { title: string; subtitle?: string; sections?: Array<{ heading: string; content: string }> }>)[instrument!];

if (!data) {
  return Astro.redirect('/unterricht');
}
---

<BaseLayout
  title={`${data.title} - Fine Sound Academy`}
  description={data.subtitle ?? `${data.title} bei der Fine Sound Academy in Düsseldorf und Neuss. Professioneller Unterricht für alle Level.`}
>
  <section class="instrument-detail">
    <div class="detail-container">
      <div class="accent-line"></div>
      <h1>{data.title}</h1>
      {data.subtitle && <p class="instrument-subtitle">{data.subtitle}</p>}

      <div class="detail-content">
        {data.sections?.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            <p>{section.content}</p>
          </section>
        ))}

        <div class="location-ctas">
          <p>Unterricht in Düsseldorf und Neuss:</p>
          <div class="cta-buttons">
            <a href={`/duesseldorf/unterricht/${instrument}`} class="cta-button">In Düsseldorf</a>
            <a href={`/neuss/unterricht/${instrument}`} class="cta-button">In Neuss</a>
          </div>
        </div>
        <a href="https://www.axinio.app/booking/forms/trial/fc60f65c-2a6f-49dd-8809-c41246cca534/" target="_blank" rel="noopener noreferrer" class="cta-button primary">Jetzt Probestunde buchen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .instrument-detail {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
    min-height: 80vh;
  }
  .detail-container {
    max-width: 65ch;
    margin: 0 auto;
  }
  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin-bottom: var(--space-2xl);
  }
  .instrument-detail h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-3xl);
    font-weight: 700;
  }
  .detail-content h2 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-text-primary);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }
  .instrument-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-3xl);
    line-height: 1.6;
  }
  .detail-content p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    line-height: 1.9;
  }
  .location-ctas {
    margin-top: var(--space-3xl);
    padding-top: var(--space-2xl);
    border-top: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }
  .location-ctas p {
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
  }
  .cta-buttons {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }
  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-2xl);
    background: transparent;
    color: var(--color-gold-on-light);
    border: var(--border-width-medium) solid var(--color-gold-on-light);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    min-height: 48px;
    border-radius: var(--radius-sm);
    transition: all var(--transition-base);
  }
  .cta-button:hover {
    background: var(--color-gold-on-light);
    color: var(--color-bg-default);
  }
  .cta-button.primary {
    margin-top: var(--space-xl);
    background: var(--color-gold);
    color: var(--color-black);
    border-color: var(--color-gold);
  }
  .cta-button.primary:hover {
    background: var(--color-gold-light);
  }
  @media (max-width: 767px) {
    .instrument-detail {
      padding: var(--space-4xl) var(--space-md);
    }
  }
</style>

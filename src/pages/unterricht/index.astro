---
import BaseLayout from '../../layouts/BaseLayout.astro';
import contentRaw from '../../../content/unterricht.json';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { INSTRUMENTS, LOCATIONS } from '../../lib/site';

const content = contentRaw as any;

/** Correct German lesson noun ("Gitarre" -> "Gitarrenunterricht"), keyed by slug. */
const lessonNoun = (slug: string, fallback: string) =>
  INSTRUMENTS.find((i) => i.slug === slug)?.lesson ?? `${fallback}unterricht`;
---

<BaseLayout
  title="Musikunterricht | Klavier, Gitarre, Gesang in Düsseldorf & Neuss"
  description="Musikunterricht in Düsseldorf und Neuss für Klavier, Gitarre, Bass, Gesang und Schlagzeug. Entdecke dein Instrument und buche eine kostenlose Probestunde."
>
  <section class="unterricht-hero" aria-labelledby="unterricht-heading">
    <div class="hero-container">
      <div class="accent-line"></div>
      <h1 id="unterricht-heading">{content.hero.title}</h1>
      <p class="hero-subtitle">{content.hero.subtitle}</p>
    </div>
  </section>

  <section class="unterricht-intro">
    <div class="intro-container">
      <p>{content.intro.text}</p>
      <div class="location-links">
        {LOCATIONS.map((loc) => (
          <a href={`/${loc.slug}/`} class="location-link">{`Musikunterricht in ${loc.name}`}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="instruments-list" aria-label="Instrumente">
    <div class="list-container">
      {
        content.instruments.map((instrument: any, index: number) => (
          <article
            id={instrument.slug}
            class={`instrument-item ${index % 2 === 0 ? 'image-left' : 'image-right'}`}
          >
            <div class="instrument-image">
              <ResponsiveImage
                src={instrument.image}
                alt={`${lessonNoun(instrument.slug, instrument.name)} bei der Fine Sound Academy`}
                preset="instrument"
                loading="lazy"
              />
            </div>
            <div class="instrument-content">
              <h2>{instrument.name}</h2>
              <p class="description">{instrument.description}</p>
              <ul class="highlights">
                {instrument.highlights.map((highlight: string) => (
                  <li>{highlight}</li>
                ))}
              </ul>
              {/* This page is the router, not a destination: send visitors
                  straight to the location page that can actually teach them.
                  The former /unterricht/<instrument>/ stubs were ~200 words and
                  competed with these for the same query. */}
              <div class="instrument-cities">
                {LOCATIONS.map((loc) => (
                  <a href={`/${loc.slug}/unterricht/${instrument.slug}/`} class="read-more">
                    {`${lessonNoun(instrument.slug, instrument.name)} in ${loc.name}`}
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="crawl-links" aria-labelledby="crawl-links-title">
    <div class="crawl-links-container">
      <h2 id="crawl-links-title">Direkte Unterrichtsseiten</h2>
      <p>Alle wichtigen Instrumentenseiten nach Standort:</p>
      <ul>
        <li><a href="/neuss/">Musikschule Neuss</a></li>
        <li><a href="/neuss/unterricht/klavier/">Klavierunterricht in Neuss</a></li>
        <li><a href="/neuss/unterricht/gitarre/">Gitarrenunterricht in Neuss</a></li>
        <li><a href="/neuss/unterricht/gesang/">Gesangsunterricht in Neuss</a></li>
        <li><a href="/neuss/unterricht/bass/">Bassunterricht in Neuss</a></li>
        <li><a href="/neuss/unterricht/schlagzeug/">Schlagzeugunterricht in Neuss</a></li>
        <li><a href="/duesseldorf/">Musikschule Düsseldorf</a></li>
        <li><a href="/duesseldorf/unterricht/klavier/">Klavierunterricht in Düsseldorf</a></li>
        <li><a href="/duesseldorf/unterricht/gitarre/">Gitarrenunterricht in Düsseldorf</a></li>
        <li><a href="/duesseldorf/unterricht/gesang/">Gesangsunterricht in Düsseldorf</a></li>
        <li><a href="/duesseldorf/unterricht/bass/">Bassunterricht in Düsseldorf</a></li>
        <li><a href="/duesseldorf/unterricht/schlagzeug/">Schlagzeugunterricht in Düsseldorf</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .unterricht-hero {
    padding: var(--space-6xl) var(--space-lg) var(--space-5xl);
    background: var(--color-bg-dark);
    text-align: center;
  }

  .hero-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-2xl);
  }

  .unterricht-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-gold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 300;
  }

  .unterricht-intro {
    padding: var(--space-4xl) var(--space-lg);
    background: var(--color-bg-default);
    text-align: center;
  }

  .intro-container {
    max-width: 900px;
    margin: 0 auto;
  }

  .unterricht-intro p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.8;
  }

  .location-links {
    display: flex;
    gap: var(--space-lg);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-2xl);
  }

  .location-link {
    padding: var(--space-md) var(--space-xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    border-radius: var(--radius-sm);
    transition: background var(--transition-base);
  }

  .location-link:hover {
    background: var(--color-gold-light);
  }

  .instruments-list {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .list-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .instrument-item {
    /* Anchor targets from the homepage instrument cards must clear the fixed nav. */
    scroll-margin-top: calc(var(--nav-height) + var(--space-lg));
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4xl);
    align-items: center;
    margin-bottom: var(--space-6xl);
    padding-bottom: var(--space-6xl);
    border-bottom: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .instrument-item:last-child {
    margin-bottom: 0;
    padding-bottom: 0;
    border-bottom: none;
  }

  .instrument-item.image-right {
    direction: rtl;
  }

  .instrument-item.image-right > * {
    direction: ltr;
  }

  .instrument-image {
    width: 100%;
    height: 400px;
    overflow: hidden;
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
    border-radius: var(--radius-md);
  }

  .instrument-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .instrument-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    line-height: 1.8;
  }

  .highlights {
    list-style: none;
    margin-bottom: var(--space-2xl);
  }

  .highlights li {
    color: var(--color-text-primary);
    padding: var(--space-xs) 0;
    padding-left: var(--space-lg);
    position: relative;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    height: 6px;
    background: var(--color-gold);
    border-radius: 50%;
  }

  .instrument-cities {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Two buttons with full lesson names need tighter gutters than the single
     "Mehr erfahren" button this replaced. */
  .instrument-cities .read-more {
    padding: var(--space-sm) var(--space-lg);
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-sm) var(--space-2xl);
    background: var(--color-gold);
    color: var(--color-black);
    text-decoration: none;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-size: var(--text-sm);
    transition: all var(--transition-base);
    border: var(--border-width-medium) solid var(--color-gold);
    min-height: 48px;
    border-radius: var(--radius-sm);
  }

  .read-more:hover {
    background: transparent;
    color: var(--color-gold-on-light);
  }

  .crawl-links {
    padding: var(--space-4xl) var(--space-lg);
    background: var(--color-bg-alt);
  }

  .crawl-links-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .crawl-links h2 {
    font-family: var(--font-serif);
    color: var(--color-text-primary);
    margin-bottom: var(--space-sm);
    text-align: center;
  }

  .crawl-links p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    text-align: center;
  }

  .crawl-links ul {
    margin: 0;
    padding-left: var(--space-lg);
    columns: 2;
    gap: var(--space-2xl);
  }

  .crawl-links li {
    margin-bottom: var(--space-sm);
  }

  .crawl-links a {
    color: var(--color-gold-on-light);
    text-decoration: none;
  }

  .crawl-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 767px) {
    .unterricht-hero {
      padding: var(--space-4xl) var(--space-md) var(--space-3xl);
    }

    .unterricht-intro {
      padding: var(--space-3xl) var(--space-md);
    }

    .instruments-list {
      padding: var(--space-4xl) var(--space-md);
    }

    .instrument-item,
    .instrument-item.image-right {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
      margin-bottom: var(--space-4xl);
      padding-bottom: var(--space-4xl);
      direction: ltr;
    }

    .instrument-image {
      height: 300px;
    }

    .crawl-links ul {
      columns: 1;
    }
  }
</style>

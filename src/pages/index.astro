---
/**
 * Startseite - und seit der Zusammenlegung zugleich die Standortseite fuer
 * Duesseldorf. /duesseldorf/ leitet per 301 hierher, weil beide Seiten sonst
 * um "Musikschule Duesseldorf" konkurrieren wuerden. Die lokalen Signale
 * (NAP, Anfahrt, Oeffnungszeiten, Reviews, Standort-FAQ) sind deshalb hierher
 * gewandert; die Instrumentseiten bleiben unter /duesseldorf/unterricht/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import TrustBlock from '../components/TrustBlock.astro';
import LocationDetails from '../components/LocationDetails.astro';
import Instruments from '../components/Instruments.astro';
import About from '../components/About.astro';
import CTA from '../components/CTA.astro';
import LocationReviews from '../components/LocationReviews.astro';
import HomepageFAQ from '../components/HomepageFAQ.astro';
import LocationInfoCards from '../components/LocationInfoCards.astro';
import Team from '../components/Team.astro';
import landing from '../../content/landing.json';
import duesseldorf from '../../content/duesseldorf.json';
import { normalizeParagraphs, normalizeLines } from '../lib/cms';
import { PRIMARY_LOCATION, PRIMARY_LOCATION_SLUG } from '../lib/site';

// Same source Hero.astro reads, so the preload in <head> matches what the
// hero's <picture> resolves to.
const heroImage = (landing as { hero?: { image?: string } }).hero?.image ?? '';

interface CityPageData {
  intro?: { heading?: string; paragraphs?: unknown };
  directionsCard?: { title?: string; lines?: unknown };
  hoursCard?: { title?: string; lines?: unknown };
  infoCards?: Array<{ title: string; description: string }>;
  cta?: { title: string; subtitle: string; buttonText: string; buttonLink: string };
  reviews?: { title?: string; items?: Array<{ name: string; text: string; instrument: string }> };
}

// Der Standort-Content bleibt in duesseldorf.json, damit das CMS eine Quelle
// behaelt und die Instrumentseiten dieselben Texte nutzen koennen.
const city = duesseldorf as CityPageData;
const introParagraphs = normalizeParagraphs(city.intro?.paragraphs);
const directionsLines = normalizeLines(city.directionsCard?.lines);
const reviews = city.reviews ?? {};
const infoCards = Array.isArray(city.infoCards) ? city.infoCards : [];

---

<BaseLayout
  title="Musikschule Düsseldorf | Klavier, Gitarre, Gesang | Fine Sound Academy"
  description="Musikschule in Düsseldorf-Pempelfort, Kaiserstraße 28: Klavier-, Gitarren- und Gesangsunterricht sowie Bass und Schlagzeug. Kostenlose Probestunde buchen."
  preloadHero={heroImage ? { src: heroImage, preset: 'hero' } : undefined}
>
  <Hero />
  <TrustBlock />

  <LocationDetails
    location={PRIMARY_LOCATION}
    heading={city.intro?.heading}
    paragraphs={introParagraphs}
    directionsTitle={city.directionsCard?.title}
    directionsLines={directionsLines}
    hoursTitle={city.hoursCard?.title}
    headingId="standort-heading"
  />

  <Instruments />
  <About school={PRIMARY_LOCATION_SLUG} />
  <CTA cta={city.cta} />
  <LocationReviews title={reviews.title ?? 'Was unsere Schüler sagen'} items={reviews.items ?? []} />
  <HomepageFAQ />
  <LocationInfoCards cards={infoCards} />

  <Team />
</BaseLayout>

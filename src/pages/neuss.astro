---
import BaseLayout from '../layouts/BaseLayout.astro';
import About from '../components/About.astro';
import CTA from '../components/CTA.astro';
import Team from '../components/Team.astro';
import Pricing from '../components/Pricing.astro';
import Contact from '../components/Contact.astro';
import { normalizeParagraphs, normalizeLines, getCities } from '../lib/cms';

const cities = await getCities();
const city = cities.find((c) => c.slug === 'neuss');
const pageData = (await import('../../content/neuss.json')).default as {
  hero?: { title: string; subtitle: string; text: string };
  intro?: { heading: string; paragraphs: unknown };
  directionsCard?: { title: string; lines: unknown };
  hoursCard?: { title: string; lines: unknown };
  instruments: { heading: string; intro: string; items: Array<{ title: string; description: string }> };
  faq: { heading: string; items: Array<{ question: string; answer: string }> };
};

const data = {
  hero: city?.hero ?? pageData.hero ?? { title: '', subtitle: '', text: '' },
  intro: city?.intro ?? pageData.intro ?? { heading: '', paragraphs: [] },
  directionsCard: city?.directionsCard ?? pageData.directionsCard ?? { title: '', lines: [] },
  hoursCard: city?.hoursCard ?? pageData.hoursCard ?? { title: '', lines: [] },
  instruments: pageData.instruments,
  faq: pageData.faq,
};

const introParagraphs = normalizeParagraphs(data.intro?.paragraphs);
const directionsLines = normalizeLines(data.directionsCard?.lines);
const hoursLines = normalizeLines(data.hoursCard?.lines);
const faqItems = Array.isArray(data.faq?.items) ? data.faq.items : [];
const instrumentItems = Array.isArray(data.instruments?.items) ? data.instruments.items : [];

const ldLocal = {
  '@context': 'https://schema.org',
  '@type': 'MusicSchool',
  name: 'Fine Sound Academy Neuss',
  description: 'Musikschule in Neuss am Neumarkt: Professioneller Unterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug. Einzel- und Gruppenunterricht für alle Altersgruppen.',
  url: 'https://www.finesoundacademy.com/neuss',
  telephone: '+49 176 77154511',
  email: 'info@finesoundacademy.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Neumarkt 18',
    addressLocality: 'Neuss',
    addressRegion: 'Nordrhein-Westfalen',
    postalCode: '41460',
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 51.1985, longitude: 6.6929 },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday'], opens: '10:00', closes: '20:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '12:00' },
  ],
  priceRange: '€€',
  areaServed: { '@type': 'City', name: 'Neuss' },
};

const ldFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<BaseLayout
  title="Musikschule Neuss – Klavier, Gitarre, Gesang, Bass & Schlagzeug | Fine Sound Academy"
  description="Musikschule Neuss: Fine Sound Academy am Neumarkt 18. Klavier, Gitarre, Gesang, Bass, Schlagzeug, Violine. Kostenlose Probestunde, Öffnungszeiten, Anfahrt."
>
  <script type="application/ld+json" set:html={JSON.stringify(ldLocal)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(ldFAQ)} slot="head" />

  <section class="location-hero" aria-labelledby="neuss-heading">
    <div class="hero-container">
      <div class="accent-line"></div>
      <h1 id="neuss-heading">{data.hero?.title ?? 'Musikschule in Neuss'}</h1>
      <p class="hero-subtitle">{data.hero?.subtitle ?? 'Fine Sound Academy — Neumarkt 18, Neusser Innenstadt'}</p>
      <p class="hero-text">{data.hero?.text ?? 'Professioneller Musikunterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug — zentral in Neuss.'}</p>
    </div>
  </section>

  <section class="location-intro" aria-label="Über den Standort Neuss">
    <div class="intro-container">
      <div class="intro-grid">
        <div class="intro-content">
          <h2>{data.intro?.heading ?? 'Deine Musikschule im Zentrum von Neuss'}</h2>
          {introParagraphs.length > 0 ? introParagraphs.map((paragraph) => <p>{paragraph}</p>) : (
            <>
              <p>Die Fine Sound Academy Neuss liegt am <strong>Neumarkt 18</strong> — direkt im Herzen der <strong>Neusser Innenstadt</strong>.</p>
              <p>Unser Standort in Neuss steht für eine <strong>familiäre Atmosphäre</strong> und persönliche Betreuung.</p>
              <p>Für <strong>Kinder ab 6 Jahren, Jugendliche und Erwachsene</strong>.</p>
            </>
          )}
        </div>
        <div class="intro-details">
          <div class="detail-card">
            <h3>{data.directionsCard?.title ?? 'Anfahrt &amp; Lage'}</h3>
            {directionsLines.length > 0 ? directionsLines.map((line) => <p>{line}</p>) : (
              <>
                <p><strong>Adresse:</strong> Neumarkt 18, 41460 Neuss</p>
                <p><strong>Bus:</strong> Haltestelle Neumarkt</p>
                <p><strong>Bahn:</strong> Neuss Hauptbahnhof — ca. 8 Min. Fußweg</p>
                <p><strong>Parken:</strong> Tiefgarage Neumarkt</p>
              </>
            )}
          </div>
          <div class="detail-card">
            <h3>{data.hoursCard?.title ?? 'Öffnungszeiten'}</h3>
            {hoursLines.length > 0 ? hoursLines.map((line) => <p>{line}</p>) : (
              <>
                <p>Montag – Freitag: 10:00 – 20:00 Uhr</p>
                <p>Samstag: 09:00 – 12:00 Uhr</p>
                <p>Sonntag: Geschlossen</p>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="instruments-overview" aria-labelledby="instruments-neuss">
    <div class="instruments-container">
      <h2 id="instruments-neuss">{data.instruments?.heading ?? 'Unser Unterrichtsangebot in Neuss'}</h2>
      <p class="section-intro">{data.instruments?.intro ?? 'Am Neumarkt bieten wir professionellen Musikunterricht für fünf Instrumente an.'}</p>
      <p><a href="/neuss/unterricht" class="instruments-cta">Alle Instrumente in Neuss →</a></p>
      <div class="instruments-grid">
        {instrumentItems.length > 0 ? instrumentItems.map((item) => (
          <div class="instrument-item">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        )) : (
          <>
            <div class="instrument-item"><h3>Klavierunterricht</h3><p>Klassik, Pop oder Jazz — lerne Klavier in deinem eigenen Tempo.</p></div>
            <div class="instrument-item"><h3>Gitarrenunterricht</h3><p>Akustik oder E-Gitarre mit Methoden, die wirklich funktionieren.</p></div>
            <div class="instrument-item"><h3>Gesangsunterricht</h3><p>Entfalte dein stimmliches Potenzial für jeden Musikstil.</p></div>
            <div class="instrument-item"><h3>Bassunterricht</h3><p>E-Bass oder Kontrabass — Groove und Zusammenspiel.</p></div>
            <div class="instrument-item"><h3>Schlagzeugunterricht</h3><p>Beats, Fills und Koordination von Rock bis Jazz.</p></div>
          </>
        )}
      </div>
    </div>
  </section>

  <About school="neuss" />
  <CTA />
  <Team location="neuss" showIntro={false} />

  <section class="faq-section" aria-labelledby="faq-neuss">
    <div class="faq-container">
      <h2 id="faq-neuss">{data.faq?.heading ?? 'Häufige Fragen zur Musikschule Neuss'}</h2>
      <div class="faq-list">
        {faqItems.length > 0 ? faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        )) : (
          <p class="faq-empty">Keine FAQ-Einträge vorhanden.</p>
        )}
      </div>
    </div>
  </section>

  <Pricing />
  <Contact location="neuss" />
</BaseLayout>

<style>
  .location-hero {
    background: var(--color-bg-dark);
    padding: calc(var(--nav-height) + var(--space-6xl)) var(--space-lg) var(--space-6xl);
    text-align: center;
  }

  .hero-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .location-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .hero-subtitle {
    color: var(--color-gold);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: var(--space-md);
  }

  .hero-text {
    color: var(--color-white-alpha-85);
    font-size: var(--text-base);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .location-intro {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .intro-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5xl);
    align-items: start;
  }

  .intro-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-2xl);
    font-weight: 600;
  }

  .intro-content p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
    font-size: var(--text-base);
  }

  .detail-card {
    background: var(--color-bg-alt);
    padding: var(--space-2xl);
    margin-bottom: var(--space-lg);
    border-left: 3px solid var(--color-gold);
  }

  .detail-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .detail-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-xs);
  }

  .instruments-overview {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-alt);
  }

  .instruments-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .instruments-container h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto var(--space-lg);
    line-height: 1.8;
  }
  .instruments-cta {
    display: inline-block;
    color: var(--color-gold-on-light);
    font-weight: 600;
    text-decoration: none;
    margin-bottom: var(--space-4xl);
  }
  .instruments-cta:hover {
    text-decoration: underline;
  }

  .instruments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .instrument-item {
    background: var(--color-surface);
    padding: var(--space-2xl);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .instrument-item h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .instrument-item p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .faq-section {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-container h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-4xl);
    font-weight: 600;
  }

  .faq-item {
    border-bottom: var(--border-width-thin) solid var(--color-gold-alpha-20);
    padding: var(--space-lg) 0;
  }

  .faq-item summary {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
  }

  .faq-item summary::after {
    content: '+';
    font-size: var(--text-xl);
    color: var(--color-gold);
    flex-shrink: 0;
    margin-left: var(--space-md);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    padding-top: var(--space-md);
    font-size: var(--text-sm);
  }

  .faq-empty {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  @media (max-width: 767px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3xl);
    }

    .location-hero {
      padding: calc(var(--nav-height) + var(--space-4xl)) var(--space-md) var(--space-4xl);
    }
  }
</style>

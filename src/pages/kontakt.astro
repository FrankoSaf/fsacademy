---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt & Probestunde – Fine Sound Academy"
  description="Kontakt & Probestunde: Fine Sound Academy Düsseldorf (Kaiserstr.) und Neuss (Neumarkt). Kostenlose Probestunde online buchen oder per WhatsApp. Unverbindlich."
>
  <section class="contact-hero" aria-labelledby="kontakt-heading">
    <div class="hero-container">
      <div class="accent-line"></div>
      <h1 id="kontakt-heading">Kontakt</h1>
      <p class="hero-subtitle">Probestunde vereinbaren</p>
      <p class="hero-text">Füll das Formular aus – wir melden uns schnellstmöglich bei dir.</p>
    </div>
  </section>

  <section class="contact-form-section" aria-label="Kontaktformular">
    <div class="form-container">
      <p class="form-trust-line">Kostenlos und unverbindlich – wir melden uns schnellstmöglich.</p>
      <form
        method="POST"
        action="/.netlify/functions/contact-submit"
        class="contact-form"
      >
        <div class="honeypot-wrap" aria-hidden="true">
          <label for="website-hp">Website</label>
          <input type="text" id="website-hp" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="form-row">
          <div class="form-group form-group-full">
            <label for="name">Vollständiger Name <span class="required">*</span></label>
            <input type="text" id="name" name="name" required autocomplete="name" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group form-group-full">
            <label for="email">E-Mail-Adresse <span class="required">*</span></label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </div>
        </div>

        <div class="form-row">
          <div class="form-group form-group-full">
            <label for="phone">Telefonnummer <span class="required">*</span></label>
            <input type="tel" id="phone" name="phone" required pattern="^[0-9\s+\-().]+$" autocomplete="tel" />
          </div>
        </div>

        <div class="form-row form-row-half">
          <div class="form-group">
            <label for="interest">Ich interessiere mich für <span class="required">*</span></label>
            <select id="interest" name="interest" required>
              <option value="" disabled hidden selected></option>
              <option value="Gesang">Gesang</option>
              <option value="Klavier">Klavier</option>
              <option value="Gitarre">Gitarre</option>
              <option value="Bass">Bass</option>
              <option value="Schlagzeug">Schlagzeug</option>
            </select>
          </div>
          <div class="form-group">
            <label for="location">Standort <span class="required">*</span></label>
            <select id="location" name="location" required>
              <option value="" disabled hidden selected></option>
              <option value="Neuss">Neuss</option>
              <option value="Düsseldorf">Düsseldorf</option>
            </select>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group form-group-full">
            <label for="message">Ihre Nachricht</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              placeholder="Terminwünsche, Vorkenntnisse, weitere Anmerkungen..."
            ></textarea>
          </div>
        </div>

        <div class="form-row form-row-consent">
          <div class="form-group form-group-checkbox">
            <label class="checkbox-label">
              <input type="checkbox" name="consent" value="true" required />
              <span>Ich stimme der Übermittlung und Verarbeitung meiner Nachricht zu. <span class="required">*</span></span>
            </label>
          </div>
        </div>

        <div class="form-status" aria-live="polite"></div>

        <div class="form-submit">
          <button type="submit" class="submit-btn">
            <span class="btn-text">Probestunde anfragen</span>
            <span class="btn-loading" aria-hidden="true">
              <svg class="spinner" width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="2" stroke-dasharray="35 12" stroke-linecap="round"/></svg>
              Wird gesendet&hellip;
            </span>
          </button>
          <p class="form-reassurance">Wir melden uns in der Regel innerhalb von 24 Stunden.</p>
        </div>
      </form>

    </div>
  </section>

  <section class="contact-info-section">
    <div class="info-container">
      <h2>Standorte</h2>
      <div class="info-cards">
        <div class="info-card">
          <h3>Düsseldorf</h3>
          <p>Kaiserstr. 28</p>
          <p>40479 Düsseldorf</p>
          <p><a href="tel:017677154511">0176 77154511</a></p>
          <p><a href="mailto:info@finesoundacademy.com">info@finesoundacademy.com</a></p>
        </div>
        <div class="info-card">
          <h3>Neuss</h3>
          <p>Neumarkt 18</p>
          <p>41460 Neuss</p>
          <p><a href="tel:017677154511">0176 77154511</a></p>
          <p><a href="mailto:info@finesoundacademy.com">info@finesoundacademy.com</a></p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero {
    padding: var(--space-6xl) var(--space-lg) var(--space-5xl);
    background: var(--color-bg-dark);
    text-align: center;
  }

  .hero-container {
    max-width: 700px;
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-2xl);
  }

  .contact-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    font-weight: 700;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-gold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-weight: 300;
    margin-bottom: var(--space-lg);
  }

  .hero-text {
    color: var(--color-white-alpha-85);
    font-size: var(--text-base);
  }

  .contact-form-section {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .form-container {
    max-width: 560px;
    margin: 0 auto;
  }

  .form-trust-line {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-secondary, #666);
    margin-bottom: var(--space-xl);
  }

  .honeypot-wrap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-reassurance {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-secondary, #666);
    margin-top: var(--space-md);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .form-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  .form-row-half {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .form-group {
    flex: 1;
    min-width: 0;
  }

  .form-group-full {
    flex: 1 1 100%;
  }

  .form-group label,
  .checkbox-label {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: var(--space-xs);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    background: var(--color-bg-default);
    border: var(--border-width-thin) solid var(--color-border-input);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-base);
  }

  .form-group input,
  .form-group select {
    min-height: 48px;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--color-border-input-focus);
    outline: none;
  }

  .form-group input:focus-visible,
  .form-group select:focus-visible,
  .form-group textarea:focus-visible {
    outline: 2px solid transparent;
    outline-offset: var(--focus-visible-offset);
    box-shadow: var(--focus-visible-ring);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 120px;
  }

  .required {
    color: var(--color-gold-on-light);
  }

  .form-group-checkbox {
    flex: 1 1 100%;
  }

  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    cursor: pointer;
    font-weight: 400;
    min-height: 44px;
    padding: var(--space-xs) 0;
  }

  .checkbox-label input {
    margin-top: 0.25rem;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    accent-color: var(--color-gold);
  }

  .form-submit {
    margin-top: var(--space-md);
  }

  .form-status {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding: var(--space-sm) var(--space-md);
    border-radius: 4px;
    display: none;
  }

  .form-status.is-error {
    display: block;
    background: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .submit-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-md) var(--space-3xl);
    background: var(--color-gold);
    color: var(--color-black);
    border: var(--border-width-medium) solid var(--color-gold);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    cursor: pointer;
    min-height: 48px;
    border-radius: var(--radius-sm);
    transition: background var(--transition-base), opacity var(--transition-base);
  }

  .submit-btn:hover {
    background: var(--color-gold-light);
  }

  .submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }

  .submit-btn:focus-visible {
    outline: 2px solid transparent;
    outline-offset: var(--focus-visible-offset);
    box-shadow: var(--focus-visible-ring);
  }

  .btn-loading {
    display: none;
    align-items: center;
    gap: var(--space-xs);
  }

  .submit-btn.is-loading .btn-text {
    display: none;
  }

  .submit-btn.is-loading .btn-loading {
    display: inline-flex;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .spinner {
    animation: spin 0.8s linear infinite;
  }

  .contact-info-section {
    padding: var(--space-5xl) var(--space-lg);
    background: var(--color-bg-alt);
  }

  .info-container {
    max-width: var(--container-wide-max-width);
    margin: 0 auto;
  }

  .contact-info-section h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-2xl);
    font-weight: 600;
    text-align: center;
  }

  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-xl);
    max-width: 700px;
    margin: 0 auto;
  }

  .info-card {
    background: var(--color-surface);
    padding: var(--space-xl);
    border-radius: var(--radius-md);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
    box-shadow: var(--shadow-card);
  }

  .info-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .info-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-xs);
  }

  .info-card a {
    color: var(--color-gold-on-light);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-xs) 0;
  }

  .info-card a:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .form-row-half {
      grid-template-columns: 1fr;
    }

    .contact-hero {
      padding: var(--space-4xl) var(--space-md) var(--space-3xl);
    }

    .contact-form-section {
      padding: var(--space-4xl) var(--space-md);
    }

    .contact-info-section {
      padding: var(--space-4xl) var(--space-md);
    }
  }
</style>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement;
  const btn = form?.querySelector('.submit-btn') as HTMLButtonElement;
  const status = form?.querySelector('.form-status') as HTMLElement;

  function setLoading(loading: boolean) {
    btn.disabled = loading;
    btn.classList.toggle('is-loading', loading);
  }

  function showError(msg: string) {
    status.textContent = msg;
    status.classList.add('is-error');
    status.style.display = '';
  }

  function clearError() {
    status.textContent = '';
    status.classList.remove('is-error');
    status.style.display = 'none';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearError();
    setLoading(true);

    try {
      const res = await fetch(form.action || window.location.pathname, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form) as any).toString(),
      });

      if (!res.ok) throw new Error(`${res.status}`);

      sessionStorage.setItem('fsa_form_success', '1');
      const params = new URLSearchParams(window.location.search);
      const utmParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
      const qs = utmParams
        .filter((k) => params.has(k))
        .map((k) => `${k}=${encodeURIComponent(params.get(k) || '')}`)
        .join('&');
      window.location.href = '/kontakt/danke' + (qs ? '?' + qs : '');
    } catch {
      showError('Etwas ist schiefgelaufen. Bitte versuche es erneut.');
    } finally {
      setLoading(false);
    }
  });

</script>

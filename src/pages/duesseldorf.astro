---
import BaseLayout from '../layouts/BaseLayout.astro';
import globals from '../../content/globals.json';
import ui from '../../content/ui.json';

const probestundeUrl = (globals as { probestundeUrl?: string }).probestundeUrl ?? 'https://www.axinio.app/booking/forms/trial/fc60f65c-2a6f-49dd-8809-c41246cca534/';
const loc = (ui as { location?: Record<string, string> }).location ?? {};
import About from '../components/About.astro';
import CTA from '../components/CTA.astro';
import Team from '../components/Team.astro';
import Pricing from '../components/Pricing.astro';
import LocationInfoCards from '../components/LocationInfoCards.astro';
import LocationReviews from '../components/LocationReviews.astro';
import { normalizeParagraphs, normalizeLines, getCities } from '../lib/cms';

const cities = await getCities();
const city = cities.find((c) => c.slug === 'duesseldorf');
const pageData = (await import('../../content/duesseldorf.json')).default as {
  hero?: { title: string; subtitle: string; text: string };
  intro?: { heading: string; paragraphs: unknown };
  directionsCard?: { title: string; lines: unknown };
  hoursCard?: { title: string; lines: unknown };
  infoCards?: Array<{ title: string; description: string }>;
  cta?: { title: string; subtitle: string; buttonText: string; buttonLink: string };
  instruments: {
    heading: string;
    intro: string;
    items: Array<{ title: string; description: string }>;
  };
  faq: { heading: string; items: Array<{ question: string; answer: string }> };
  reviews?: { title: string; items: Array<{ name: string; text: string; instrument: string }> };
};

const data = {
  hero: city?.hero ?? pageData.hero ?? { title: '', subtitle: '', text: '' },
  intro: city?.intro ?? pageData.intro ?? { heading: '', paragraphs: [] },
  directionsCard: city?.directionsCard ??
    pageData.directionsCard ?? { title: '', lines: [] },
  hoursCard: city?.hoursCard ?? pageData.hoursCard ?? { title: '', lines: [] },
  infoCards: (city as any)?.infoCards ?? pageData.infoCards ?? [],
  cta: (city as any)?.cta ?? pageData.cta,
  instruments: pageData.instruments,
  faq: pageData.faq,
  reviews: pageData.reviews ?? { title: 'Was unsere Schüler sagen', items: [] },
};

const introParagraphs = normalizeParagraphs(data.intro?.paragraphs);
const directionsLines = normalizeLines(data.directionsCard?.lines);
const hoursLines = normalizeLines(data.hoursCard?.lines);
const faqItems = Array.isArray(data.faq?.items) ? data.faq.items : [];
const instrumentItemsRaw = Array.isArray(data.instruments?.items)
  ? data.instruments.items
  : [];
const titleToSlug: Record<string, string> = {
  Klavierunterricht: 'klavier',
  Gitarrenunterricht: 'gitarre',
  Gesangsunterricht: 'gesang',
  Bassunterricht: 'bass',
  Schlagzeugunterricht: 'schlagzeug',
};
const instrumentItems = instrumentItemsRaw.map(
  (item: { title: string; description: string }) => ({
    ...item,
    slug:
      (item as { slug?: string }).slug ??
      titleToSlug[item.title] ??
      item.title
        .toLowerCase()
        .replace(/unterricht$/, '')
        .replace(/\s/g, '-'),
  }),
);

const ldLocal = {
  '@context': 'https://schema.org',
  '@type': 'MusicSchool',
  name: 'Fine Sound Academy Düsseldorf',
  description:
    'Musikschule in Düsseldorf-Pempelfort: Professioneller Unterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug. Einzel- und Gruppenunterricht für alle Altersgruppen.',
  url: 'https://www.finesoundacademy.com/duesseldorf',
  telephone: '+49 176 77154511',
  email: 'info@finesoundacademy.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Kaiserstr. 28',
    addressLocality: 'Düsseldorf',
    addressRegion: 'Nordrhein-Westfalen',
    postalCode: '40479',
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 51.23387, longitude: 6.77908 },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '10:00',
      closes: '20:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '12:00',
    },
  ],
  priceRange: '€€',
  areaServed: { '@type': 'City', name: 'Düsseldorf' },
};

const ldFAQ = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const landingData = (await import('../../content/landing.json')).default as { hero?: { image?: string } };
const heroImage = landingData?.hero?.image ?? '';
---

<BaseLayout
  title="Musikschule Düsseldorf – Klavier, Gitarre, Gesang, Bass & Schlagzeug | Fine Sound Academy"
  description="Musikschule Düsseldorf: Fine Sound Academy am Kaiserstr. 28 (Pempelfort). Klavier, Gitarre, Gesang, Bass, Schlagzeug. Kostenlose Probestunde, Öffnungszeiten, Anfahrt."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(ldLocal)}
    slot="head"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(ldFAQ)}
    slot="head"
  />

  <section class="location-hero" aria-labelledby="duesseldorf-heading">
    {heroImage && (
      <>
        <div class="location-hero-picture">
          <img src={heroImage} alt="" fetchpriority="high" />
        </div>
        <div class="location-hero-overlay"></div>
      </>
    )}
    <div class="hero-container">
      <div class="accent-line"></div>
      <h1 id="duesseldorf-heading">
        {data.hero?.title ?? 'Musikschule in Düsseldorf'}
      </h1>
      <p class="hero-subtitle">
        {
          data.hero?.subtitle ??
            'Fine Sound Academy — Kaiserstraße 28, Pempelfort'
        }
      </p>
      <p class="hero-text">
        {
          data.hero?.text ??
            'Professioneller Musikunterricht für Klavier, Gitarre, Gesang, Bass und Schlagzeug — mitten in Düsseldorf.'
        }
      </p>
    </div>
  </section>

  <section class="location-intro" aria-label="Über den Standort Düsseldorf">
    <div class="intro-container">
      <div class="intro-grid">
        <div class="intro-content">
          <h2>
            {
              data.intro?.heading ??
                'Deine Musikschule im Herzen von Düsseldorf-Pempelfort'
            }
          </h2>
          {
            introParagraphs.length > 0 ? (
              introParagraphs.map((paragraph) => <p>{paragraph}</p>)
            ) : (
              <>
                <p>
                  Die Fine Sound Academy Düsseldorf liegt in der{' '}
                  <strong>Kaiserstraße 28</strong>, im beliebten Stadtteil{' '}
                  <strong>Pempelfort</strong> — einem der lebendigsten Viertel
                  Düsseldorfs.
                </p>
                <p>
                  Unsere modern ausgestatteten Unterrichtsräume bieten eine
                  inspirierende Atmosphäre für konzentriertes Lernen.
                </p>
                <p>
                  Wir unterrichten{' '}
                  <strong>
                    Kinder ab 6 Jahren, Jugendliche und Erwachsene
                  </strong>{' '}
                  — vom absoluten Anfänger bis zum fortgeschrittenen Musiker.
                </p>
              </>
            )
          }
        </div>
        <div class="intro-details">
          <div class="detail-card">
            <h3>{data.directionsCard?.title ?? 'Anfahrt &amp; Lage'}</h3>
            {
              directionsLines.length > 0 ? (
                directionsLines.map((line) => <p>{line}</p>)
              ) : (
                <>
                  <p>
                    <strong>Adresse:</strong> Kaiserstr. 28, 40479 Düsseldorf
                  </p>
                  <p>
                    <strong>Stadtteil:</strong> Pempelfort
                  </p>
                  <p>
                    <strong>U-Bahn:</strong> Haltestelle Nordstraße (U78, U79) —
                    3 Min. Fußweg
                  </p>
                  <p>
                    <strong>Parken:</strong> Straßenparkplätze in der
                    Kaiserstraße und Umgebung
                  </p>
                </>
              )
            }
          </div>
          <div class="detail-card">
            <h3>{data.hoursCard?.title ?? 'Öffnungszeiten'}</h3>
            {
              hoursLines.length > 0 ? (
                hoursLines.map((line) => <p>{line}</p>)
              ) : (
                <>
                  <p>Montag – Freitag: 10:00 – 20:00 Uhr</p>
                  <p>Samstag: 09:00 – 12:00 Uhr</p>
                  <p>Sonntag: Geschlossen</p>
                </>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    class="instruments-overview"
    aria-labelledby="instruments-duesseldorf"
  >
    <div class="instruments-container">
      <h2 id="instruments-duesseldorf">
        {data.instruments?.heading ?? 'Unser Unterrichtsangebot in Düsseldorf'}
      </h2>
      <p class="section-intro">
        {
          data.instruments?.intro ??
            'An unserem Standort in der Kaiserstraße bieten wir professionellen Unterricht für fünf Instrumente an.'
        }
      </p>
      <p>
        <a href="/duesseldorf/unterricht" class="instruments-cta"
          >{(loc.alleInstrumente ?? 'Alle Instrumente')} in Düsseldorf →</a>
      </p>
      <div class="instruments-grid">
        {
          instrumentItems.length > 0 ? (
            instrumentItems.map((item) => (
              <div class="instrument-item">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a
                  href={`/duesseldorf/unterricht/${item.slug}`}
                  class="instrument-link"
                >
                  Mehr erfahren
                </a>
              </div>
            ))
          ) : (
            <>
              <div class="instrument-item">
                <>
                  <h3>Klavierunterricht</h3>
                  <p>
                    Vom ersten Akkord bis zur Konzertvorbereitung. Klassik, Pop,
                    Jazz.
                  </p>
                  <a
                    href="/duesseldorf/unterricht/klavier"
                    class="instrument-link"
                  >
                    Mehr erfahren
                  </a>
                </>
              </div>
              <div class="instrument-item">
                <>
                  <h3>Gitarrenunterricht</h3>
                  <p>Akustik oder E-Gitarre, Fingerpicking oder Riffs.</p>
                  <a
                    href="/duesseldorf/unterricht/gitarre"
                    class="instrument-link"
                  >
                    Mehr erfahren
                  </a>
                </>
              </div>
              <div class="instrument-item">
                <>
                  <h3>Gesangsunterricht</h3>
                  <p>
                    Entdecke deine Stimme. Atemtechnik, Stimmbildung und
                    Interpretation.
                  </p>
                  <a
                    href="/duesseldorf/unterricht/gesang"
                    class="instrument-link"
                  >
                    Mehr erfahren
                  </a>
                </>
              </div>
              <div class="instrument-item">
                <>
                  <h3>Bassunterricht</h3>
                  <p>Das Fundament jeder Band. E-Bass oder Akustikbass.</p>
                  <a
                    href="/duesseldorf/unterricht/bass"
                    class="instrument-link"
                  >
                    Mehr erfahren
                  </a>
                </>
              </div>
              <div class="instrument-item">
                <>
                  <h3>Schlagzeugunterricht</h3>
                  <p>
                    Rhythmus, Koordination und Energie für alle Stilrichtungen.
                  </p>
                  <a
                    href="/duesseldorf/unterricht/schlagzeug"
                    class="instrument-link"
                  >
                    Mehr erfahren
                  </a>
                </>
              </div>
            </>
          )
        }
      </div>
    </div>
  </section>

  <About school="duesseldorf" />
  <LocationReviews title={data.reviews.title} items={data.reviews.items} />
  <CTA cta={data.cta} />
  <Team location="duesseldorf" showIntro={false} />

  <section class="faq-section" aria-labelledby="faq-duesseldorf">
    <div class="faq-container">
      <h2 id="faq-duesseldorf">
        {data.faq?.heading ?? 'Häufige Fragen zur Musikschule Düsseldorf'}
      </h2>
      <div class="faq-list">
        {
          faqItems.length > 0 ? (
            faqItems.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))
          ) : (
            <p class="faq-empty">{loc.keineFaq ?? 'Keine FAQ-Einträge vorhanden.'}</p>
          )
        }
      </div>
    </div>
  </section>

  <Pricing showHeader={true} headingLevel="h2" />
  <LocationInfoCards cards={data.infoCards} />
  <section class="location-cta-section" aria-label="Probestunde buchen">
    <div class="location-cta-inner">
      <p class="location-cta-heading">{loc.probestundeVereinbaren ?? 'Probestunde vereinbaren'}</p>
      <a
        href={probestundeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="location-cta-button"
      >
        {loc.kostenloseProbestundeBuchen ?? 'Kostenlose Probestunde buchen'}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .location-hero {
    position: relative;
    background: var(--color-bg-dark);
    padding: calc(var(--nav-height) + var(--space-6xl)) var(--space-lg)
      var(--space-6xl);
    text-align: center;
    overflow: hidden;
  }
  .location-hero-picture {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }
  .location-hero-picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .location-hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 10, 10, 0.55);
    z-index: 1;
  }
  .location-hero .hero-container {
    position: relative;
    z-index: 2;
  }

  .hero-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .accent-line {
    width: 60px;
    height: var(--border-width-medium);
    background: var(--color-gold);
    margin: 0 auto var(--space-lg);
  }

  .location-hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-3xl), 6vw, var(--text-5xl));
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-lg);
    font-weight: 700;
  }

  .hero-subtitle {
    color: var(--color-gold);
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-tight);
    text-transform: uppercase;
    font-weight: 400;
    margin-bottom: var(--space-md);
  }

  .hero-text {
    color: var(--color-white-alpha-85);
    font-size: var(--text-base);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .location-intro {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .intro-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5xl);
    align-items: start;
  }

  .intro-content h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    margin-bottom: var(--space-2xl);
    font-weight: 600;
  }

  .intro-content p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    margin-bottom: var(--space-lg);
    font-size: var(--text-base);
  }

  .detail-card {
    background: var(--color-bg-alt);
    padding: var(--space-2xl);
    margin-bottom: var(--space-lg);
    border-left: 3px solid var(--color-gold);
  }

  .detail-card h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .detail-card p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-xs);
  }

  .instruments-overview {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-alt);
  }

  .instruments-container {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }

  .instruments-container h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-lg);
    font-weight: 600;
  }

  .section-intro {
    text-align: center;
    color: var(--color-text-secondary);
    max-width: 700px;
    margin: 0 auto var(--space-lg);
    line-height: 1.8;
  }
  .instruments-cta {
    display: inline-block;
    color: var(--color-gold-on-light);
    font-weight: 600;
    text-decoration: none;
    margin-bottom: var(--space-4xl);
  }
  .instruments-cta:hover {
    text-decoration: underline;
  }

  .instruments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-2xl);
  }

  .instrument-item {
    background: var(--color-surface);
    padding: var(--space-2xl);
    border: var(--border-width-thin) solid var(--color-gold-alpha-20);
  }

  .instrument-item h3 {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .instrument-item p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.8;
    margin-bottom: var(--space-md);
  }
  .instrument-item .instrument-link {
    display: inline-block;
    color: var(--color-gold-on-light);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    margin-top: var(--space-sm);
  }
  .instrument-item .instrument-link:hover {
    text-decoration: underline;
  }

  .faq-section {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-bg-default);
  }

  .faq-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .faq-container h2 {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-2xl), 4vw, var(--text-3xl));
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: var(--space-4xl);
    font-weight: 600;
  }

  .faq-item {
    border-bottom: var(--border-width-thin) solid var(--color-gold-alpha-20);
    padding: var(--space-lg) 0;
  }

  .faq-item summary {
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text-primary);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 44px;
  }

  .faq-item summary::after {
    content: '+';
    font-size: var(--text-xl);
    color: var(--color-gold);
    flex-shrink: 0;
    margin-left: var(--space-md);
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .faq-item p {
    color: var(--color-text-secondary);
    line-height: 1.8;
    padding-top: var(--space-md);
    font-size: var(--text-sm);
  }

  .faq-empty {
    color: var(--color-text-secondary);
    font-style: italic;
  }

  .location-cta-section {
    padding: var(--space-6xl) var(--space-lg);
    background: var(--color-gold);
    text-align: center;
  }
  .location-cta-inner {
    max-width: var(--container-max-width);
    margin: 0 auto;
  }
  .location-cta-heading {
    font-family: var(--font-serif);
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    color: var(--color-black);
    margin-bottom: var(--space-xl);
    font-weight: 600;
  }
  .location-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-md) var(--space-3xl);
    background: var(--color-black);
    color: var(--color-white);
    font-weight: 600;
    font-family: var(--font-sans);
    text-decoration: none;
    border-radius: var(--radius-sm);
    min-height: 48px;
    transition: background var(--transition-base), color var(--transition-base);
  }
  .location-cta-button:hover {
    background: var(--color-white);
    color: var(--color-black);
  }

  @media (max-width: 767px) {
    .intro-grid {
      grid-template-columns: 1fr;
      gap: var(--space-3xl);
    }

    .location-hero {
      padding: calc(var(--nav-height) + var(--space-4xl)) var(--space-md)
        var(--space-4xl);
    }
  }
</style>
